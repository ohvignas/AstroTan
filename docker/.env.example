# docker/.env.example — copier en `docker/.env` SUR LE VPS (jamais commité,
# jamais dans une image). La CI ne l'écrase pas : elle ne pousse que le
# compose et la config Traefik, et passe `IMAGE_TAG` en variable de la
# commande.

# Propriétaire GHCR (organisation ou utilisateur GitHub), en minuscules.
GHCR_OWNER=ohvignas

# Tag d'image à faire tourner. La CI le passe explicitement à chaque
# déploiement (le sha du commit). Une valeur figée ici ne sert que si l'on
# lance `docker compose up` à la main sur le VPS.
IMAGE_TAG=latest

# Domaines servis par Traefik. Les enregistrements DNS A/AAAA doivent
# pointer sur ce VPS AVANT le premier démarrage : le challenge HTTP-01 de
# Let's Encrypt échoue sinon, et un échec répété fait tomber le rate limit.
WEB_DOMAIN=illith.com
ADMIN_DOMAIN=admin.illith.com

# Pas d'`ACME_EMAIL` ici, et ce n'est pas un oubli. L'adresse de contact
# Let's Encrypt se règle dans `traefik/traefik.yml`, parce que Traefik
# n'interpole pas les variables dans sa configuration statique et n'y
# fusionne ni environnement ni arguments de ligne de commande dès qu'un
# fichier est monté (vérifié sur traefik 3.6.25 ; le raisonnement complet
# et la trace sont en tête de `traefik/traefik.yml`). Une variable
# `ACME_EMAIL` dans ce fichier serait lue par le compose puis ignorée par
# Traefik — l'adresse resterait celle du YAML sans que rien ne le signale.

# URLs publiques du déploiement Convex de production. Non secrètes.
VITE_CONVEX_URL=https://example-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://example-deployment.convex.site

# Secrets partagés avec le déploiement Convex, valeur identique des deux
# côtés (`npx convex env set` là-bas, ce fichier ici). Générer chacun une
# fois par `openssl rand -hex 32`. Un `REVALIDATE_SECRET` divergent fait
# échouer toutes les invalidations de publication (refusées, retentées,
# `failed` après 6 essais) ; un `PREVIEW_SECRET` divergent fait rejeter
# tous les jetons de prévisualisation.
PREVIEW_SECRET=CHANGE-ME-not-a-real-secret
REVALIDATE_SECRET=CHANGE-ME-not-a-real-secret
