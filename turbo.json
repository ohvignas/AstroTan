{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "codegen": { "cache": false },
    "typecheck": { "dependsOn": ["^codegen"] },
    "test": { "dependsOn": ["^codegen"] },
    "build": { "dependsOn": ["^codegen", "^build"], "outputs": ["dist/**", ".output/**"] },
    "dev": { "cache": false, "persistent": true }
  }
}
