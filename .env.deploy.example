# .env.deploy.example — copier en `.env.deploy` (gitignoré) et remplir.
#
# C'est le SEUL fichier que vous remplissez à la main. `pnpm bootstrap` en
# distribue ensuite les valeurs vers les trois destinations qui ne peuvent
# pas se lire entre elles — le déploiement Convex, les secrets GitHub, les
# `.env` de développement local — et produit le bloc à coller dans le `.env`
# du VPS.
#
# Ce fichier ne contient QUE ce qu'un humain doit décider ou aller chercher.
# Les secrets que personne ne choisit à la main (`BETTER_AUTH_SECRET`,
# `PREVIEW_SECRET`, `REVALIDATE_SECRET`) sont générés par le script à la
# première exécution et RÉÉCRITS ici, pour être stables ensuite. Ne les
# régénérez pas : ce sont des clés HMAC partagées, une rotation unilatérale
# casse la prévisualisation et l'invalidation de cache
# (`docker/README.md` §6).
#
# Chaque `.env.example` du dépôt reste la référence sur ce que chaque valeur
# signifie et ce qu'elle casse si elle est fausse. Ce fichier-ci ne dit que
# où la trouver.

# ── Domaines ────────────────────────────────────────────────────────────────
# Hôtes NUS, sans `https://` ni slash final : le compose les injecte dans des
# règles de routage Traefik (``Host(`…`)``), pas dans des URLs.
# Leurs enregistrements DNS doivent pointer sur le VPS AVANT le premier
# démarrage (`docker/README.md` §3).
WEB_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com

# Adresse d'enregistrement du compte ACME chez Let's Encrypt. Une adresse
# invalide fait échouer la délivrance de TOUS les certificats.
ACME_EMAIL=you@example.com

# ── Premier compte du dashboard ─────────────────────────────────────────────
# Adresse à laquelle `pnpm bootstrap` envoie le lien du PREMIER compte —
# rôle `owner`, le seul qui pourra ensuite en inviter d'autres. L'accès est
# sur invitation seule (`disableSignUp: true`, pas d'OAuth) : sans ce
# compte, personne n'entre dans le dashboard, jamais.
#
# Facultative. Vide, le script reprend `ACME_EMAIL` et vous le demande s'il
# tourne dans un terminal — puis réécrit ici la réponse, pour ne plus poser
# la question. Séparée d'`ACME_EMAIL` parce que ce sont deux rôles
# différents : l'une reçoit les avis d'expiration de certificat, l'autre
# détient le compte.
#
# Aucun mot de passe ne passe par ce fichier ni par le script : `bootstrap`
# rend un lien `/accept-invite?token=…`, et le mot de passe se choisit sur
# la page normale.
ADMIN_EMAIL=

# ── GitHub ──────────────────────────────────────────────────────────────────
# Dépôt qui porte les secrets Actions, au format `owner/nom`. Le script le
# passe en `gh secret set --repo` : il ne le devine jamais, et un dépôt sans
# remote git configuré ne lui donne aucun autre moyen de le connaître.
GITHUB_REPOSITORY=your-github-username/astrotan

# Propriétaire des packages GHCR d'où le VPS tire les images, EN MINUSCULES
# (GHCR rejette les majuscules). C'est en général le `owner` ci-dessus, mais
# pas forcément la même casse — d'où deux variables.
GHCR_OWNER=your-github-username

# ── Convex (déploiement de PRODUCTION) ──────────────────────────────────────
# Les deux URLs telles que le dashboard Convex les affiche. Non secrètes :
# elles finissent dans les bundles navigateur.
CONVEX_CLOUD_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# Clé de déploiement de production : dashboard Convex → le déploiement →
# Settings → Deploy keys → Generate production deploy key.
# SECRET — c'est un accès complet au backend (elle autorise le remplacement
# du schéma et des functions). Le script s'en sert pour deux choses : la
# poser en secret GitHub, et cibler le bon déploiement pour `convex env set`.
CONVEX_DEPLOY_KEY=CHANGE-ME-not-a-real-secret

# ── VPS ─────────────────────────────────────────────────────────────────────
VPS_HOST=vps.example.com

# L'utilisateur NON-ROOT membre du groupe `docker` (`docker/README.md` §1).
VPS_USER=deploy

# Chemin de la clé PRIVÉE de déploiement sur ce poste. Le script en lit le
# contenu pour le poser en secret `VPS_SSH_KEY` ; il ne le recopie nulle part
# ailleurs et ne l'affiche jamais.
# La générer dédiée à cet usage, jamais une clé personnelle :
#   ssh-keygen -t ed25519 -C deploy@astrotan -f ~/.ssh/astrotan_deploy
# puis poser la publique dans `~/.ssh/authorized_keys` du VPS.
VPS_SSH_KEY_PATH=~/.ssh/astrotan_deploy

# ── Resend ──────────────────────────────────────────────────────────────────
# Clé API des emails d'invitation (https://resend.com). SECRÈTE.
# Laisser VIDE est un choix valide : le script ne pose alors pas la variable
# et le dit. Les invitations continuent d'être créées ; c'est l'envoi
# programmé qui échoue, visible en job en échec dans le dashboard Convex
# (`packages/backend/.env.example`).
RESEND_API_KEY=

# Garde-fou : tant que ce n'est pas la chaîne littérale `false`, Resend ne
# délivre qu'à ses adresses de test. Ne passer à `false` qu'après avoir
# vérifié un domaine d'envoi.
RESEND_TEST_MODE=true
