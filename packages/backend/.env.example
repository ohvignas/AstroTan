# Signs cookies and derives verification/state tokens; generate a long random value (e.g. `openssl rand -base64 32`) and set it on the Convex deployment with `npx convex env set`, never commit the real value.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public origin of the site that owns the Better Auth session (e.g. https://admin.illith.com in production); set on the Convex deployment with `npx convex env set`.
SITE_URL=http://localhost:3000
