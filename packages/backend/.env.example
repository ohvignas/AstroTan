# packages/backend — these variables live on the CONVEX DEPLOYMENT, not in a
# file. This one only documents them. Set each with:
#
#   pnpm --filter @astrotan/backend exec convex env set <NAME> <value>
#
# and list what is set with `convex env list`. Never commit real values.

# What: signs Better Auth cookies and derives verification/state tokens.
# Where: generate one with `openssl rand -base64 32`.
# Secret: YES — full session-forgery power.
# If wrong: `createAuth` refuses to start. Its guard rejects a missing value,
#   a value under 32 characters, and Better Auth's publicly-known default —
#   so the placeholder below fails loudly if pasted verbatim.
BETTER_AUTH_SECRET=CHANGE-ME-not-a-real-secret

# What: public origin of the site that owns the Better Auth session — the
#   DASHBOARD (`apps/admin`), never the public site. Also the base
#   `invitations.ts` builds its `/accept-invite?token=…` links from.
# Where: your dashboard domain (e.g. `https://admin.example.com`).
# Secret: no.
# If wrong: invitation links point at the wrong host. Unset, the scheduled
#   send throws and shows as a failed job in the Convex dashboard.
SITE_URL=http://localhost:3001

# `BETTER_AUTH_SECRET` and `SITE_URL` are only required for auth instances
# that serve HTTP requests (`convex/http.ts`). Regenerating the Better Auth
# schema needs neither: `convex/betterAuth/auth.ts` is an introspection-only
# shim that opts out with `createAuth({} as any, { requireSecret: false })`.
# That is the ONLY place allowed to do so — `grep -rn "requireSecret: false"
# packages/backend` must return exactly that one line.

# What: HMAC key for preview tokens (`convex/lib/previewToken.ts`, spec §6.3).
#   Signs and re-verifies `{type}:{id}:{expiresAt}` for `previewPage`. It is
#   the only thing between a draft page and anyone who guesses a preview URL,
#   since `apps/web` carries no session at all.
# Where: generate one with `openssl rand -hex 32`. Set the SAME value on the
#   `web` side (apps/web/.env.example locally, the VPS `.env` in production).
# Secret: YES.
# If wrong: every preview token is rejected. Unset or under 32 characters,
#   `signPreviewToken`/`verifyPreviewToken` throw instead of degrading.
PREVIEW_SECRET=CHANGE-ME-not-a-real-secret

# What: shared secret `convex/revalidate.ts`'s `drain` action sends as the
#   `x-revalidate-secret` header on every POST to
#   `${WEB_SITE_URL}/api/revalidate` (spec §6.2).
# Where: generate one with `openssl rand -hex 32`. Set the SAME value on the
#   `web` side.
# Secret: YES. Never sent to a browser.
# If wrong: `apps/web` refuses every invalidation; `drain` retries with
#   backoff and marks the row `failed` after 6 attempts. Published pages stay
#   stale until the cache expires, with nothing else visibly broken.
REVALIDATE_SECRET=CHANGE-ME-not-a-real-secret

# What: public origin of `apps/web` — where `drain` POSTs its
#   `/api/revalidate` requests. Deliberately NOT the same variable as
#   `SITE_URL` above: that one is Better Auth's `baseURL` and belongs to the
#   dashboard, a different origin entirely.
# Where: your public site domain (e.g. `https://example.com`). Same value as
#   `apps/admin`'s `VITE_WEB_SITE_URL`.
# Secret: no.
# If wrong: invalidations POST to the wrong host and never reach a live page.
#   Unset, `drain` throws rather than silently no-op'ing.
WEB_SITE_URL=http://localhost:4321

# What: Resend API key used by `invitations.ts` to send invitation emails.
# Where: https://resend.com, then `convex env set`.
# Secret: YES.
# If wrong: `resend.sendEmail` throws "API key is not set" from inside the
#   SCHEDULED send, never from `invitations.create` — so a missing key costs
#   you the email, never the invitation itself.
RESEND_API_KEY=

# What: safety rail. The Resend component defaults to `testMode: true`, which
#   only delivers to Resend's test addresses (e.g. delivered@resend.dev), so a
#   misconfigured dev deployment cannot mail real people.
# Where: set to the literal string `false` — and only after verifying a
#   sending domain in the Resend dashboard — to deliver for real.
# Secret: no.
# If wrong: `invitations.ts` reads it as `!== "false"`, so any other value
#   (including unset) keeps test mode and real invitations are never
#   delivered.
RESEND_TEST_MODE=true
