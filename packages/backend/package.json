{
  "name": "@astrotan/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "codegen": "test -d convex/_generated && echo \"convex/_generated present. It is committed and must be regenerated (never hand-edited) via a real 'npx convex dev --once' against a running deployment — this script deliberately never pushes on its own; see CLAUDE.md's Convex rules.\" || (echo \"convex/_generated is missing. Regenerate it with a real 'npx convex dev --once' against a running deployment before typecheck/test.\" && exit 1)",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.42",
    "@convex-dev/agent": "^0.7.1",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/rag": "^0.7.6",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/resend": "0.2.7",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.89",
    "better-auth": "1.6.17",
    "convex": "1.45.0",
    "convex-helpers": "0.1.123",
    "mammoth": "^1.12.2",
    "pdf-lib": "^1.17.1",
    "marked": "18.0.11",
    "unpdf": "^1.8.1",
    "yoastseo": "3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "22.20.1",
    "convex-test": "0.0.56",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
