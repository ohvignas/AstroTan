# Same values as packages/backend/.env.local's CONVEX_URL/CONVEX_SITE_URL
# (or the deployment's real *.convex.cloud/*.convex.site URLs in
# production) — the VITE_ prefix is what exposes them to the browser
# bundle too, since src/router.tsx builds its ConvexReactClient from
# VITE_CONVEX_URL directly.
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Public origin of `apps/web` (e.g. https://illith.com in production) —
# not a secret, just the base the pages editor (Task 8) appends
# `/preview/page/{id}?t={token}` to for the "Preview" button. The token
# itself comes from `api.pages.mintPreviewToken`; this is only ever the
# host it's opened against. Same value as `packages/backend/.env.local`'s
# `WEB_SITE_URL`.
VITE_WEB_SITE_URL=http://localhost:4321
