# apps/admin — copy this file to `apps/admin/.env.local` and fill it in.
# In production these are Docker build-args AND runtime variables of the
# `admin` container, and the two must match: Vite freezes them into the
# client bundle at build time while `src/lib/auth-server.ts` reads them from
# `process.env` at runtime. See docker/README.md §12.
#
# None of the three is a secret — the `VITE_` prefix ships them to the
# browser bundle by design. Never add a real secret with this prefix.

# What: the Convex deployment the dashboard talks to. `src/router.tsx` builds
#   its `ConvexReactClient` from it.
# Where: `npx convex dev` prints it; the Convex dashboard shows it as the
#   deployment URL. In production, `https://<deployment>.convex.cloud`.
# If wrong: the dashboard loads but no data ever arrives.
VITE_CONVEX_URL=http://127.0.0.1:3210

# What: the HTTP origin of that same deployment — the one Better Auth is
#   served from.
# Where: same deployment, `.site` instead of `.cloud`
#   (`https://<deployment>.convex.site`). Locally it is the sibling port of
#   `VITE_CONVEX_URL`.
# If wrong: sign-in fails while the rest of the UI looks fine. Nothing
#   detects it — `/api/health` has no dependencies by construction.
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# What: the public origin of `apps/web`. The pages editor appends
#   `/{slug}?t={token}` to it for the "Preview" button — the preview opens at
#   the page's real URL, because the token signs the slug (CLAUDE.md
#   invariant 2). The token itself comes from `api.pages.mintPreviewToken`.
# Where: your own public site domain (e.g. `https://example.com` in
#   production). Same value as the Convex deployment's `WEB_SITE_URL`.
# If wrong: the "Preview" button opens the wrong host — or, unset, refuses
#   with "VITE_WEB_SITE_URL n'est pas configuré côté admin."
VITE_WEB_SITE_URL=http://localhost:4321
