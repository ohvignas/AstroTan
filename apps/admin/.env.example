# Same values as packages/backend/.env.local's CONVEX_URL/CONVEX_SITE_URL
# (or the deployment's real *.convex.cloud/*.convex.site URLs in
# production) — the VITE_ prefix is what exposes them to the browser
# bundle too, since src/router.tsx builds its ConvexReactClient from
# VITE_CONVEX_URL directly.
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211
