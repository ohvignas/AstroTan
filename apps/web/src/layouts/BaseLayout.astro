---
// Le squelette de toutes les pages publiques, porté de
// `src/layouts/BaseLayout.astro` d'`astro-emdash`.
//
// Le template y met sa propre couche SEO (`components/seo/SEO.astro`), son
// i18n et sa recherche modale. Ici le `<head>` est tenu par `PageHead` — le
// composant qui rend ce que l'administration décide : titre, description,
// canonique, `robots`, Open Graph, GEO, JSON-LD et favicon. Garder les deux
// aurait donné deux jeux de balises `<title>` et `og:*` divergents dans le
// même document.
//
// `Analytics` (Umami) est ici et NULLE PART ailleurs : une page qui
// contournerait ce layout serait une page non mesurée, et le trou ne se
// verrait pas. Le contrôle tient en une commande :
//
//   curl -s http://127.0.0.1:4331/<chemin> | grep -c data-website-id   # → 1
import PageHead from "../components/PageHead.astro"
import Analytics from "../components/Analytics.astro"
import Header from "../components/layout/Header.astro"
import Footer from "../components/layout/Footer.astro"
import NotFoundBody from "../components/NotFoundBody.astro"
import GoogleConsentMode from "../components/consent/GoogleConsentMode.astro"
import ConsentBanner from "../components/consent/ConsentBanner.astro"
import ChatBubble from "../components/chat/ChatBubble.astro"
import type { PageRecord } from "../lib/loadPage"
import "../styles/global.css"

// Les polices sont préchargées depuis le module résolu par le bundler, et
// non depuis une URL écrite à la main : le nom du fichier porte un hachage
// qui change à chaque mise à jour de Fontsource, et un chemin figé
// précharge alors un fichier que la page n'utilise pas — le navigateur
// télécharge deux fois et n'avertit de rien.
import outfitLatin from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url"
import manropeLatin from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url"

export interface Props {
  page: PageRecord | null
  fallbackTitle?: string
  article?: {
    title: string
    excerpt?: string
    publishedAt?: number
    coverUrl?: string | null
    coverAlt?: string
  }
}

const { page, fallbackTitle, article } = Astro.props as Props

// Le nonce de la CSP, lu ici plutôt que directement dans la balise.
//
// Le compilateur Astro ne lie l'objet global du composant que s'il apparaît
// dans le frontmatter. Le lire uniquement depuis un attribut du gabarit lève
// « Astro is not defined » AU RENDU — le typecheck, lui, ne voit rien.
const nonce = Astro.locals.nonce
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link
      rel="preload"
      href={outfitLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={manropeLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    {/* Amorçage du thème, avant le premier peint.
        Le défaut est CLAIR. Seul un choix explicite du visiteur, mémorisé
        sous la clé `theme`, passe la page en sombre — un
        `prefers-color-scheme: dark` ne suffit pas, parce que le site a une
        identité claire et qu'un réglage système ne dit pas que quelqu'un
        veut CE site en sombre.

        Ce script est en ligne et synchrone à dessein. Différé, une page
        choisie en sombre s'afficherait en clair une fraction de seconde
        avant de basculer — le clignotement blanc que tout le monde
        reconnaît. C'est aussi pourquoi il ne fait qu'AJOUTER une classe :
        ne rien faire est déjà le mode clair, donc le cas courant ne coûte
        aucune écriture dans le DOM. */}
    <script is:inline nonce={nonce}>
      try {
        if (localStorage.getItem("theme") === "dark") {
          document.documentElement.classList.add("dark")
        }
      } catch {
        // `localStorage` inaccessible (navigation privée verrouillée,
        // cookies bloqués) : on reste en clair, le défaut.
      }
    </script>

    {/* AVANT `Analytics` et avant toute balise tierce : Consent Mode pose
        un défaut « tout refusé » que Google doit connaître avant de recevoir
        quoi que ce soit. Après, le défaut arriverait trop tard. */}
    <GoogleConsentMode />

    <PageHead page={page} fallbackTitle={fallbackTitle} article={article} />
    <Analytics />
    <slot name="head" />
  </head>
  <body class="site-body">
    <a href="#main-content" class="skip-link">Aller au contenu</a>

    <Header />

    {Astro.locals.preview && (
      <p class="preview-banner">
        Aperçu — cette page n'est pas publiée. Le lien expire au bout de 15
        minutes.
      </p>
    )}

    <main id="main-content" class="site-main">
      {Astro.response.status === 404 ? <NotFoundBody /> : <slot />}
    </main>

    <Footer />

    {/* En fin de `<body>` : le bandeau ne doit pas retarder le premier
        rendu. Il ne s'affiche que si ce site charge réellement un traceur
        soumis à consentement — sinon le composant ne rend rien du tout. */}
    <ConsentBanner />
    {/* Sous le bandeau cookies (z-index 60) et sous le `<dialog>` modal
        (couche supérieure du navigateur). La bulle reste à 45. */}
    <ChatBubble />

    <style>
      .site-body {
        display: flex;
        min-height: 100svh;
        flex-direction: column;
      }

      .site-main {
        flex: 1;
      }

      .preview-banner {
        margin: 0;
        padding: 0.6rem 1rem;
        text-align: center;
        font-size: 0.875rem;
        color: var(--foreground);
        background: color-mix(in srgb, var(--warning) 25%, transparent);
        border-bottom: 1px solid color-mix(in srgb, var(--warning) 45%, transparent);
      }
    </style>
  </body>
</html>
