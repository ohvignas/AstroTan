---
// Lot 2, Task 6 ([...slug].astro] and any other on-demand page) — the
// shared `<html>` shell and per-page SEO surface (design spec §6.5:
// title, description, og:image, canonical, noindex — plus the global
// `Organization` JSON-LD). `index.astro` (Task 4's scaffold) predates
// this layout and still hand-rolls its own `<html>`; out of scope here.
import "../styles/global.css"
import { SITE_NAME } from "../lib/siteConfig"

interface Props {
  title: string
  description?: string
  /** Absolute URL — callers compute this once (current request or the
   * page's own `seo.canonicalUrl` override) rather than the layout
   * guessing at it. */
  canonicalUrl: string
  noindex?: boolean
  /** Absolute URL to an Open Graph image. Currently always `undefined` in
   * practice: `page.seo.ogImageId` is a raw `_storage` id with no
   * resolved URL available from `getPublishedPage` yet (see
   * `[...slug].astro`'s own comment on this gap). The prop exists so
   * wiring a resolved URL in later is a one-line change here, not a
   * second pass over every caller. */
  ogImageUrl?: string
}

const { title, description, canonicalUrl, noindex = false, ogImageUrl } = Astro.props

// Global, not per-page (design spec §6.5: "JSON-LD `Organization`
// global"). Built entirely from this app's own constants and the
// request's own origin — never from `page.seo` or block content — so,
// unlike `RichText.astro`'s `set:html`, there is no editor-authored value
// flowing into this `set:html` call and nothing here needs sanitizing.
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE_NAME,
  url: Astro.url.origin,
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
