---
// Everything the dashboard decides about how a page is found, rendered
// into the document head. Dropped into every page's `<head>`; it is the
// only thing the SEO and GEO panels reach.
import { api } from "@astrotan/backend/convex/_generated/api"
import type { Id } from "@astrotan/backend/convex/_generated/dataModel"
import { getConvexClient } from "../lib/convexClient"
import {
  proxifierFavicon,
  proxifierPartage,
  resolveShareImage,
  texteAltPartage,
} from "../lib/headImages"
import siteIcon from "../assets/icon_astrotan.png"
import type { PageRecord } from "../lib/loadPage"
import {
  articleJsonLd,
  breadcrumbJsonLd,
  faqJsonLd,
  organizationJsonLd,
  serializeJsonLd,
  type SiteIdentity,
} from "../lib/jsonLd"

interface Props {
  page: PageRecord | null
  /** Fallback title for the 404 case, where there is no row to read. */
  fallbackTitle?: string
  /**
   * Set on an article so this renders `Article` and a breadcrumb rather
   * than a bare page. Everything else is shared.
   */
  article?: {
    title: string
    excerpt?: string
    publishedAt?: number
    coverUrl?: string | null
    coverAlt?: string
  }
}

const { page, fallbackTitle = "Page introuvable", article } = Astro.props

const title = page?.seo?.title || page?.title || fallbackTitle

// `seo.canonicalUrl` overrides the computed current-URL default; stripped
// of query and hash either way, since a page's canonical identity should
// not depend on a tracking parameter, a fragment, or the `?t=` of a
// preview link.
const canonicalUrl =
  page?.seo?.canonicalUrl ??
  new URL(Astro.url.pathname, Astro.url.origin).href

// Two independent switches, and collapsing them would take a decision that
// is not ours: `noindex` keeps the page out of search results, `noai` asks
// answer engines not to reproduce its content. A page can legitimately
// want the second without the first.
const noindex = page?.seo?.noindex ?? false
const noai = page?.geo?.noai ?? false

const robots = [noindex ? "noindex, nofollow" : "index, follow"]
if (noai) robots.push("noai", "noimageai")

const settings = await getConvexClient().query(api.settings.get, {})
const site: SiteIdentity = {
  siteName: settings?.siteName ?? "AstroTan",
  logoUrl: settings?.logoId
    ? await getConvexClient().query(api.media.publicUrl, {
        storageId: settings.logoId,
      })
    : null,
  socials: settings?.socials ?? [],
}

// Image de partage : couverture d'article d'abord, puis `seo.ogImageId`
// encore en base (expand), puis le défaut du site. Une balise `og:image`
// vide est pire que rien — la plateforme affiche un cadre cassé.
const shareImage = resolveShareImage({
  coverUrl: article?.coverUrl,
  ogImageId: page?.seo?.ogImageId,
  defaultOgImageId: settings?.defaultSeo?.ogImageId,
})
const shareStorageId =
  shareImage?.kind === "storage" ? (shareImage.storageId as Id<"_storage">) : null
const ogImageBrute =
  shareImage?.kind === "cover"
    ? shareImage.url
    : shareStorageId
      ? await getConvexClient().query(api.media.publicUrl, {
          storageId: shareStorageId,
        })
      : null
const ogImage = ogImageBrute
  ? await proxifierPartage(ogImageBrute, Astro.url.origin)
  : null
const ogCaption = shareStorageId
  ? await getConvexClient().query(api.media.publicCaption, {
      storageId: shareStorageId,
    })
  : article?.coverAlt
    ? { alt: article.coverAlt }
    : null
const ogImageAlt = texteAltPartage(ogCaption, title)

const description = page?.seo?.description ?? settings?.defaultSeo?.description

// L'icône téléversée depuis les réglages l'emporte sur celle du dépôt —
// même arbitrage que le logo dans l'en-tête. Sans icône, le logo sert
// quand même de favicon plutôt que de laisser le fichier du template.
// Le fichier embarqué reste le dernier repli, pour un clone jamais configuré.
const iconStorageId = settings?.iconId ?? settings?.logoId
const iconDistante = iconStorageId
  ? await getConvexClient().query(api.media.publicUrl, { storageId: iconStorageId })
  : null

// 64 px et non 32 : un onglet sur écran à haute densité affiche le
// favicon en 32 points, donc 64 pixels réels. 180 px pour l'icône iOS.
const faviconUrl = iconDistante ? await proxifierFavicon(iconDistante, 64) : siteIcon.src
const appleTouchUrl = iconDistante
  ? await proxifierFavicon(iconDistante, 180)
  : siteIcon.src

// `noai` suppresses every structured block, not just the robots hint. An
// extract built to be quoted, published on a page whose operator asked not
// to be quoted, would empty that switch of its meaning.
const structured = noai
  ? []
  : [
      organizationJsonLd(site, Astro.url.origin),
      article ? articleJsonLd(article, site, canonicalUrl) : null,
      faqJsonLd(page?.geo?.faq),
      article
        ? breadcrumbJsonLd([
            { name: "Accueil", url: new URL("/", Astro.url.origin).href },
            { name: "Blog", url: new URL("/blog", Astro.url.origin).href },
            { name: article.title, url: canonicalUrl },
          ])
        : null,
    ].filter((block) => block !== null)

// Le nonce de la CSP, lu ici plutôt que directement dans la balise.
//
// Le compilateur Astro ne lie l'objet global du composant que s'il apparaît
// dans le frontmatter. Le lire uniquement depuis un attribut du gabarit lève
// « Astro is not defined » AU RENDU — le typecheck, lui, ne voit rien.
const nonce = Astro.locals.nonce
---

{/* L'ICÔNE, jamais le logo large : un favicon de 32 px rendrait le nom
    écrit illisible. L'icône téléversée l'emporte, puis le logo, puis le
    fichier du dépôt — pour qu'un clone jamais configuré ait quand même
    un favicon. */}
<link rel="icon" href={faviconUrl} />
<link rel="apple-touch-icon" href={appleTouchUrl} />

<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robots.join(", ")} />

<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:title" content={title} />
<meta property="og:url" content={canonicalUrl} />
{description && <meta property="og:description" content={description} />}

{/* The GEO summary, exposed where an answer engine reads it rather than
    only where a human does. Suppressed under `noai` — publishing an
    extract designed to be quoted, on a page whose operator asked not to be
    quoted, would defeat the switch. */}
{page?.geo?.summary && !noai && (
  <meta name="description:summary" content={page.geo.summary} />
)}
{page?.geo?.entities && page.geo.entities.length > 0 && !noai && (
  <meta name="keywords" content={page.geo.entities.join(", ")} />
)}

{ogImage && <meta property="og:image" content={ogImage.href} />}
{ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
{ogImage?.width && <meta property="og:image:width" content={String(ogImage.width)} />}
{ogImage?.height && <meta property="og:image:height" content={String(ogImage.height)} />}

{/* `summary_large_image` only when there IS an image: the large card
    renders an empty band without one. */}
<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{ogImage && <meta name="twitter:image" content={ogImage.href} />}

{/* Le nonce sur un bloc JSON-LD n'est pas de la superstition : ce n'est pas
    du code exécutable, mais plusieurs navigateurs appliquent quand même
    `script-src` à tout élément `<script>`, quel que soit son `type`. Sans
    lui, les données structurées disparaissent du document — et un site qui
    perd son balisage sémantique ne le voit nulle part. */}
{structured.map((block) => (
  <script
    is:inline
    type="application/ld+json"
    nonce={nonce}
    set:html={serializeJsonLd(block)}
  />
))}
