---
import { api } from "@astrotan/backend/convex/_generated/api"
import { resolveAgentAvatarUrl } from "@astrotan/backend/convex/lib/agentAvatar"
import { getConvexClient } from "../../lib/convexClient"
import ChatBubbleIsland from "./ChatBubble.tsx"

// Query dédiée, pas `settings.get` : l'apparence du widget n'a rien à
// faire dans la query que le `<head>` et le middleware relisent. Un
// timeout ici ne doit pas 500 la page — le site se vend sans la bulle.
type ChatAppearance = {
  agentEnabled: boolean
  agentAvatarUrl: string | null
  agentChatColor: string | null
  agentTeaser: string | null
  agentDisplayName: string | null
}

let appearance: ChatAppearance | null = null
try {
  appearance = (await getConvexClient().query(
    api.settings.chatAppearance,
    {},
  )) as ChatAppearance | null
} catch {
  appearance = null
}

const avatarUrl = resolveAgentAvatarUrl(appearance?.agentAvatarUrl)
---

{
  appearance?.agentEnabled === true && (
    <div class="chat-bubble-root">
      <ChatBubbleIsland
        client:idle
        avatarUrl={avatarUrl}
        color={appearance.agentChatColor}
        teaser={appearance.agentTeaser}
        agentName={appearance.agentDisplayName}
      />
    </div>
  )
}
