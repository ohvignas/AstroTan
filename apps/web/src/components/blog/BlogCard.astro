---
// La carte d'article, portée de `src/components/blog/BlogCard.astro`
// d'`astro-emdash` : deux variantes, `grid` (vignette au-dessus) et `list`
// (la mise en avant, en deux colonnes).
import { Card } from "../ui/index"
import PostCover from "./PostCover.astro"
import TagPills from "./TagPills.astro"
import { readingTime } from "../../lib/toc"
import type { PostSummary, PublicTag } from "../../lib/loadPost"

export interface Props {
  post: PostSummary
  variant?: "grid" | "list"
  /** `h2` quand les cartes sont directement sous le `h1` de la page. */
  headingLevel?: "h2" | "h3"
  /** Texte de repli quand l'article n'a pas de résumé saisi. */
  fallbackExcerpt?: string
  /** Libellés déjà résolus par `tags.listPublic` — jamais des ids bruts. */
  tags?: PublicTag[]
}

const {
  post,
  variant = "grid",
  headingLevel = "h3",
  fallbackExcerpt = "",
  tags = [],
} = Astro.props as Props

const Heading = headingLevel
const href = `/blog/${post.slug}`
const dateFormat = new Intl.DateTimeFormat("fr-FR", { dateStyle: "medium" })

const raw = post.excerpt || fallbackExcerpt
const excerpt = raw.length > 180 ? `${raw.slice(0, 177)}…` : raw
---

<Card hover={true} class={`blog-card blog-card--${variant}`}>
  {/* La vignette est un second lien vers la même cible : `aria-hidden` et
      `tabindex="-1"` l'ôtent au clavier et aux lecteurs d'écran, pour ne
      pas annoncer deux fois le même article. */}
  <a slot="header" class="blog-card__media" href={href} aria-hidden="true" tabindex="-1">
    <PostCover
      coverUrl={post.coverUrl}
      coverAlt={post.coverAlt}
      coverTitle={post.coverTitle}
      title={post.title}
    />
  </a>
  <div class="blog-card__body">
    {variant === "list" && <span class="blog-card__kicker">À la une</span>}
    <p class="blog-card__meta">
      {post.publishedAt && (
        <time datetime={new Date(post.publishedAt).toISOString()}>
          {dateFormat.format(post.publishedAt)}
        </time>
      )}
      <span class="blog-card__dot" aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min de lecture</span>
    </p>
    <Heading class="blog-card__title"><a href={href}>{post.title}</a></Heading>
    <TagPills tags={tags} />
    {excerpt && <p class="blog-card__excerpt">{excerpt}</p>}
  </div>
</Card>

<style>
  .blog-card {
    height: 100%;
  }

  .blog-card__media {
    display: block;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  /* `:global()` : l'image est rendue par `<PostCover>`, un composant
     enfant, hors de portée d'un style scopé. */
  .blog-card__media :global(img),
  .blog-card__media :global(span) {
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .blog-card:hover .blog-card__media :global(img) {
    transform: scale(1.03);
  }

  .blog-card__body {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  .blog-card__kicker {
    justify-self: start;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--brand, var(--muted-foreground));
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
  }

  .blog-card__dot {
    opacity: 0.5;
  }

  .blog-card__title {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .blog-card__title a:hover {
    color: var(--brand, var(--color-brand-primary));
  }

  .blog-card__excerpt {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.65;
    font-size: 0.9375rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* === Variante « à la une » : mise en page éditoriale horizontale === */
  :global(.blog-card--list) {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: stretch;
  }

  :global(.blog-card--list) .blog-card__media {
    aspect-ratio: auto;
    height: 100%;
    min-height: 17rem;
    border-bottom: none;
    border-right: 1px solid var(--color-border);
  }

  :global(.blog-card--list .ui-card__body) {
    align-content: center;
    gap: var(--space-md);
    padding: var(--space-2xl);
  }

  :global(.blog-card--list) .blog-card__title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    -webkit-line-clamp: 3;
  }

  :global(.blog-card--list) .blog-card__excerpt {
    font-size: 1rem;
    -webkit-line-clamp: 3;
  }

  @media (width <= 48rem) {
    :global(.blog-card--list) {
      grid-template-columns: 1fr;
    }

    :global(.blog-card--list) .blog-card__media {
      aspect-ratio: 1200 / 630;
      min-height: 0;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    :global(.blog-card--list .ui-card__body) {
      padding: var(--space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card__media :global(img),
    .blog-card:hover .blog-card__media :global(img) {
      transition: none;
      transform: none;
    }
  }
</style>
