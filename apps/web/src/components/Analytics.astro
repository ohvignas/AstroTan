---
// Les scripts de mesure, et l'interrupteur qui les garde optionnels.
//
// La décision — lesquels charger, et si l'on en charge — vit dans
// `lib/analyticsScripts.ts`, qui est testé. Ici il ne reste que le rendu :
// c'est ce qui permet de vérifier « le site ne parle à personne sans
// configuration » sans avoir à rendre une page.
//
// Les deux variables sont `PUBLIC_` et doivent l'être : l'URL du script et
// l'identifiant du site apparaissent dans le source de chaque page de tout
// site mesuré par Umami. Les identifiants qui *lisent* les statistiques sont
// une autre affaire et n'approchent jamais le navigateur — voir
// `convex/analytics.ts`.
import { analyticsScripts } from "../lib/analyticsScripts"

const scripts = analyticsScripts(import.meta.env)

// Le nonce de la CSP, lu ici plutôt que directement dans la balise.
//
// Le compilateur Astro ne lie l'objet global du composant que s'il apparaît
// dans le frontmatter. Le lire uniquement depuis un attribut du gabarit lève
// « Astro is not defined » AU RENDU — le typecheck, lui, ne voit rien.
const nonce = Astro.locals.nonce
---

{
  scripts.map((script) => (
    // `defer` plutôt qu'`async` : la mesure ne doit pas concourir avec le
    // rendu de la page. Une mesure qui coûte du temps au visiteur mesure un
    // site qu'elle a elle-même ralenti.
    // `nonce` : sous `'strict-dynamic'`, l'origine d'Umami dans
    // `script-src` ne suffit pas — le mot-clé fait ignorer toute la liste
    // d'origines, et seul le nonce autorise encore une balise du document.
    // `is:inline` est explicite plutôt que déduit de la présence d'un
    // attribut : ce script n'a rien à faire passer par le bundler.
    <script
      is:inline
      defer
      nonce={nonce}
      src={script.src}
      data-website-id={script.websiteId}
    />
  ))
}
