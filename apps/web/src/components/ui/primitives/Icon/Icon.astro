  "lucide:shield":
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  "lucide:container":
    '<path d="M22 7.7c0-.6-.4-1.2-.8-1.5l-6.3-3.9a1.72 1.72 0 0 0-1.7 0l-10.3 6c-.5.2-.9.8-.9 1.4v6.6c0 .5.4 1.2.8 1.5l6.3 3.9a1.72 1.72 0 0 0 1.7 0l10.3-6c.5-.3.9-1 .9-1.5z"/><path d="M10 21.9V14L2.1 9.1"/><path d="m10 14 11.9-6.9"/><path d="M14 19.8v-8.1"/><path d="M18 17.5V9.4"/>',
  "lucide:bar-chart":
    '<path d="M3 3v18h18"/><rect width="4" height="7" x="7" y="10"/><rect width="4" height="12" x="15" y="5"/>',
  // Ajoutées pour la page des fonctionnalités. Un nom d'icône absent de
  // cette table ne rend RIEN — pas d'erreur, pas de carré vide, juste une
  // case blanche que seul l'œil attrape. C'est pour ça qu'on ajoute le
  // tracé plutôt que de rabattre le libellé sur une icône approchante.
  "lucide:lock":
    '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  "lucide:route":
    '<circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/>',
  "lucide:eye-off":
    '<path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.5 13.5 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4"/><path d="m2 2 20 20"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/>',
  "lucide:image":
    '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.09-3.09a2 2 0 0 0-2.82 0L6 21"/>',
  "lucide:inbox":
    '<polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>',
  "lucide:activity":
    '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
}

const {
  name,
  size = 20,
  decorative = true,
  label,
  class: className,
} = Astro.props as Props

const socialId = name.startsWith("social:") ? name.slice("social:".length) : null
const social = socialId ? SOCIAL_ICONS[socialId as keyof typeof SOCIAL_ICONS] : undefined
const body = social?.paths ?? PATHS[name] ?? ""
const filled = social?.variant === "fill"

// `import.meta.env.DEV` : en production, une icône manquante reste un défaut
// cosmétique et ne justifie pas de renvoyer une page en erreur à un
// visiteur. En développement, elle justifie d'arrêter tout de suite.
if (body === "" && import.meta.env.DEV) {
  throw new Error(
    `Icon : « ${name} » n'existe pas. Ajouter son tracé dans ` +
      `src/components/ui/primitives/Icon/Icon.astro, ou corriger le nom. ` +
      `Disponibles : ${Object.keys(PATHS).join(", ")}`,
  )
}
---

{
  body && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill={filled ? "currentColor" : "none"}
      stroke={filled ? "none" : "currentColor"}
      stroke-width={filled ? undefined : 2}
      stroke-linecap={filled ? undefined : "round"}
      stroke-linejoin={filled ? undefined : "round"}
      role={decorative ? undefined : "img"}
      aria-hidden={decorative ? "true" : undefined}
      aria-label={decorative ? undefined : (label ?? name)}
      focusable="false"
      set:html={body}
    />
  )
}
