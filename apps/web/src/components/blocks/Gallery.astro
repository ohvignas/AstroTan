---
// One of the six block components `src/lib/blockRegistry.ts` maps
// `Block["type"]` to (Lot 2, Task 5).
//
// `block.mediaIds` references `_storage` directly (no `media` table yet —
// see `blocks.ts`'s own comment, and `Hero.astro`'s header for the same
// gap on `mediaId`). `getPublishedPage` returns the raw storage ids, not
// resolved URLs, so there is nothing to point an `<img src>` at yet. This
// renders the gallery's structure (a count, one placeholder tile per
// image) rather than fabricating a broken image URL — swap the
// placeholder for a real `<img>` once a resolved URL is available.
import type { Block } from "@astrotan/backend/convex/blocks"

interface Props {
  block: Extract<Block, { type: "gallery" }>
}

const { block } = Astro.props
---

<section class="px-6 py-16">
  <div class="mx-auto max-w-5xl">
    {
      block.mediaIds.length === 0 ? (
        <p class="text-center text-sm text-ink-mid">No images in this gallery yet.</p>
      ) : (
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {block.mediaIds.map((mediaId) => (
            <div
              class="aspect-square rounded-card border border-rule bg-accent-50"
              data-media-id={mediaId}
            />
          ))}
        </div>
      )
    }
  </div>
</section>
