---
// One of the six block components `src/lib/blockRegistry.ts` maps
// `Block["type"]` to (Lot 2, Task 5).
import type { Block } from "@astrotan/backend/convex/blocks"

interface Props {
  block: Extract<Block, { type: "faq" }>
}

const { block } = Astro.props
---

<section class="px-6 py-16">
  <div class="mx-auto max-w-3xl divide-y divide-rule">
    {
      block.items.map((item) => (
        <details class="group py-4">
          <summary class="cursor-pointer list-none text-base font-medium text-ink marker:content-none">
            {item.question}
          </summary>
          <p class="mt-2 text-sm text-ink-mid">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
