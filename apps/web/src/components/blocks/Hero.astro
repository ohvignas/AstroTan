---
// One of the six block components `src/lib/blockRegistry.ts` maps
// `Block["type"]` to (Lot 2, Task 5). Receives the whole discriminated
// `block` prop rather than its individual fields — `Extract<Block, {type:
// "hero"}>` below narrows it to this variant only, the same pattern every
// other block component in this directory follows so the registry's
// `Record<Block["type"], AstroComponentFactory>` can stay uniform.
import type { Block } from "@astrotan/backend/convex/blocks"
import CtaLink from "../CtaLink.astro"

interface Props {
  block: Extract<Block, { type: "hero" }>
}

const { block } = Astro.props

// `block.mediaId` references `_storage` directly (no `media` table exists
// yet — see `blocks.ts`'s own comment on `mediaId`/`mediaIds`). Resolving
// a storage id to a servable URL requires `ctx.storage.getUrl()`, which
// only runs inside a Convex function; `getPublishedPage` (the query this
// app calls) does not resolve it today, so there is no URL to render here.
// Rather than guess at a storage URL scheme, this block simply renders no
// image when `mediaId` is set — a real gap to close once a resolved URL
// is available from Convex, not a silent broken `<img>`.
---

<section class="bg-paper px-6 py-20 text-center sm:py-28">
  <div class="mx-auto max-w-3xl">
    <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">{block.title}</h1>
    {
      block.subtitle && (
        <p class="mt-6 text-lg text-ink-mid">{block.subtitle}</p>
      )
    }
    {
      block.cta && (
        <div class="mt-10">
          <CtaLink cta={block.cta} variant="primary" />
        </div>
      )
    }
  </div>
</section>
