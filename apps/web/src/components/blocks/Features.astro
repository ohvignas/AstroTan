---
// One of the six block components `src/lib/blockRegistry.ts` maps
// `Block["type"]` to (Lot 2, Task 5).
//
// Contrast fix (Lot 2, Task 7): this section previously had no
// `background-color` of its own — unlike `Hero.astro` (`bg-paper`) and
// `Cta.astro` (`bg-accent-50`), which explicitly paint their own light
// background. `text-ink`/`text-ink-mid` are fixed dark tones
// (`packages/tokens/theme.css`), correct only against a light backdrop;
// without an explicit one here, this section rendered on whatever was
// behind it — in practice the browser's own `Canvas` system color, which
// follows the OS/browser's light-vs-dark preference regardless of any
// class on this page (no `color-scheme` is set anywhere in this app).
// Under a dark preference that meant dark text and a barely-visible
// border on a near-black background — confirmed visually, not assumed:
// screenshotted the seeded `lot2-task6-verify-published` page in a dark
// color scheme and the card text was effectively unreadable. `bg-paper`
// on the section (matching `Hero.astro`'s own pattern) and `bg-accent-50`
// on each card (echoing `Gallery.astro`'s placeholder tiles) make this
// block paint its own surface unconditionally, so its text is guaranteed
// to sit on the light background its colors assume — never on whatever
// happens to be behind it.
import type { Block } from "@astrotan/backend/convex/blocks"

interface Props {
  block: Extract<Block, { type: "features" }>
}

const { block } = Astro.props
---

<section class="bg-paper px-6 py-16">
  <div class="mx-auto grid max-w-5xl gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      block.items.map((item) => (
        <div class="rounded-card border border-rule bg-accent-50 p-6">
          <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
          <p class="mt-2 text-sm text-ink-mid">{item.body}</p>
        </div>
      ))
    }
  </div>
</section>
