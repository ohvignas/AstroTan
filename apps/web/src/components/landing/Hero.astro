---
// La première section de la page d'accueil de démonstration.
//
// Elle vend AstroTan. Qui reprend ce template supprime ce dossier entier :
// c'est le seul contenu du dépôt qui parle du produit plutôt que d'être le
// produit.
//
// Le fond est en CSS pur — un dégradé radial et une grille en
// `repeating-linear-gradient`. Aucune image, donc aucun octet de plus et
// aucun décalage de mise en page au chargement.
interface Props {
  eyebrow?: string
  title: string
  subtitle: string
}
const { eyebrow, title, subtitle } = Astro.props
---

<section class="relative overflow-hidden border-b border-rule">
  <!-- `aria-hidden` : ces deux calques sont décoratifs. Annoncés à un
       lecteur d'écran, ils n'apporteraient que du bruit. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.035] [background-image:repeating-linear-gradient(0deg,var(--color-ink)_0_1px,transparent_1px_64px),repeating-linear-gradient(90deg,var(--color-ink)_0_1px,transparent_1px_64px)]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 h-[32rem] w-[52rem] -translate-x-1/2 rounded-full bg-accent-500/10 blur-3xl"
  >
  </div>

  <div class="relative mx-auto max-w-3xl px-6 py-24 text-center sm:py-32">
    {eyebrow && (
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-rule bg-surface px-3 py-1 font-mono text-xs tracking-tight text-ink-mid">
        {eyebrow}
      </p>
    )}

    <h1 class="text-4xl font-semibold leading-[1.1] tracking-tight sm:text-6xl">
      {title}
    </h1>

    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink-mid">
      {subtitle}
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="#ce-qu-il-y-a-dedans"
        class="inline-flex h-11 items-center justify-center rounded-lg bg-ink px-6 text-sm font-medium text-paper no-underline transition-opacity hover:opacity-90"
      >
        Voir ce qu'il y a dedans
      </a>
      <a
        href="/blog"
        class="inline-flex h-11 items-center justify-center rounded-lg border border-rule px-6 text-sm font-medium text-ink no-underline transition-colors hover:bg-surface"
      >
        Lire le blog de démonstration
      </a>
    </div>

    <p class="mt-8 font-mono text-xs text-ink-faint">
      Astro 7 · TanStack Start · Convex · Better Auth · Docker
    </p>
  </div>
</section>
