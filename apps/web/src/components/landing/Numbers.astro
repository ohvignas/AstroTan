---
// Quatre chiffres, tous mesurés sur ce dépôt — pas des ordres de grandeur.
//
// C'est le passage de la page où il serait le plus tentant d'arrondir. Un
// chiffre invérifiable dans une vitrine technique se retourne contre elle :
// le premier lecteur qui ouvre l'onglet réseau le vérifie.
interface Figure {
  value: string
  label: string
  detail: string
}
const figures: Figure[] = [
  {
    value: "0",
    label: "octet de JavaScript",
    detail: "sur les pages publiques, mesuré sur le build de production",
  },
  {
    value: "12,8 ko",
    label: "à la première visite",
    detail: "HTML + CSS, compressés ; ~2 ko par page ensuite",
  },
  {
    value: "778",
    label: "tests automatisés",
    detail: "541 backend, 139 admin, 98 site",
  },
  {
    value: "1",
    label: "commande pour revenir en arrière",
    detail: "le rollback rejoue le pipeline entier sur un sha",
  },
]
---

<section class="border-b border-rule">
  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-px overflow-hidden bg-rule px-6 sm:grid-cols-2 lg:grid-cols-4 lg:px-0">
    {figures.map((figure) => (
      <div class="bg-paper px-6 py-10">
        {/* `tabular-nums` : sans lui, les chiffres se décalent d'une colonne
            à l'autre au gré de la largeur des glyphes. */}
        <p class="text-3xl font-semibold tabular-nums tracking-tight">{figure.value}</p>
        <p class="mt-1 text-sm font-medium">{figure.label}</p>
        <p class="mt-2 text-xs leading-relaxed text-ink-faint">{figure.detail}</p>
      </div>
    ))}
  </div>
</section>
