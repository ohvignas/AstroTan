---
// Le bloc de jauges, porté de
// `src/components/landing/LighthouseScores.astro` d'`astro-emdash`.
//
// Le template y affiche quatre scores Lighthouse à 100. Nous ne les avons
// pas mesurés sur ce dépôt, et afficher un 100 non mesuré dans une vitrine
// technique est exactement le genre d'affirmation que le premier lecteur
// vérifie — et qui se retourne. Le composant garde donc sa forme et reçoit
// des chiffres qui, eux, sont mesurés.
//
// Seule différence de style avec le template : la jauge est une pilule à
// largeur variable plutôt qu'un cercle fixe, parce que « 12,8 ko » ne tient
// pas dans 4,75 rem. Un cercle pour trois valeurs et une pilule pour la
// quatrième aurait été pire que quatre pilules.

export interface Gauge {
  value: string
  label: string
  detail?: string
  /** Teinte : `good` par défaut, les autres pour un score dégradé. */
  tone?: "good" | "warn" | "bad"
}

export interface Props {
  items?: Gauge[]
}

const {
  items = [
    { value: "100", label: "Performance" },
    { value: "100", label: "Accessibilité" },
    { value: "100", label: "Bonnes pratiques" },
    { value: "100", label: "SEO" },
  ],
} = Astro.props as Props

const toneClass = { good: "is-green", warn: "is-amber", bad: "is-red" } as const
---

<ul class="lighthouse">
  {items.map((item) => (
    <li class={`lighthouse__score ${toneClass[item.tone ?? "good"]}`}>
      <div class="lighthouse__gauge">
        <strong>{item.value}</strong>
      </div>
      <span class="lighthouse__label">{item.label}</span>
      {item.detail && <span class="lighthouse__detail">{item.detail}</span>}
    </li>
  ))}
</ul>

<style>
  .lighthouse {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 768px) {
    .lighthouse {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .lighthouse__score {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.75rem;
    padding: 1.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--card);
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .lighthouse__score:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, currentColor 30%, var(--color-border));
  }

  .lighthouse__gauge {
    display: grid;
    place-items: center;
    min-width: 4.75rem;
    height: 4.75rem;
    padding-inline: 1rem;
    border-radius: var(--radius-full);
    border: 4px solid currentColor;
    background: color-mix(in srgb, currentColor 8%, var(--card));
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      /* La touche de marque sur le seul endroit qui affirme un chiffre. */
    color: var(--brand);
  }

  .lighthouse__score:hover .lighthouse__gauge {
    transform: scale(1.05);
  }

  .lighthouse__gauge strong {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--foreground);
    line-height: 1;
    letter-spacing: -0.02em;
    /* Sans `tabular-nums`, les chiffres se décalent d'une jauge à
       l'autre au gré de la largeur des glyphes. */
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .lighthouse__label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--foreground);
    letter-spacing: -0.01em;
  }

  .lighthouse__detail {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--faint-foreground);
    max-width: 22ch;
  }

  .is-green {
    color: var(--success);
  }

  .is-amber {
    color: var(--warning);
  }

  .is-red {
    color: var(--destructive);
  }
</style>
