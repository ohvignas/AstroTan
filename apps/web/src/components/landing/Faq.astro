---
// Les questions qu'on pose vraiment avant d'adopter un template, y compris
// celles dont la réponse n'arrange pas.
//
// `<details>` plutôt qu'un accordéon en JavaScript : le navigateur sait
// déjà faire, c'est accessible au clavier par construction, et le contenu
// reste dans le HTML — donc lisible par un moteur de recherche même replié.
interface Item {
  question: string
  answer: string
}
const items: Item[] = [
  {
    question: "Peut-on modifier le contenu d'une page depuis l'administration ?",
    answer:
      "Non, et c'est un choix. Une page est son fichier .astro : le balisage, la mise en page et les mots s'écrivent en code, depuis une maquette. L'administration règle le titre, le slug, le statut, le SEO et le GEO. Trois modèles de contenu éditable ont été essayés puis retirés — chacun était une seconde façon, plus faible, de faire ce que le code fait déjà.",
  },
  {
    question: "Comment ajoute-t-on une page ?",
    answer:
      "En écrivant src/pages/mon-slug.astro et en recopiant quatre lignes en tête. Il n'y a rien d'autre à brancher : ni route à déclarer, ni menu à mettre à jour.",
  },
  {
    question: "Faut-il un compte Convex payant ?",
    answer:
      "Non pour développer : un déploiement local anonyme suffit et ne demande aucune authentification. Pour la production, c'est le déploiement hébergé de Convex, dont le palier gratuit couvre largement un site vitrine.",
  },
  {
    question: "Que se passe-t-il si un service tiers tombe ?",
    answer:
      "Le site continue de servir ses pages depuis son cache. Côté administration, une panne de la mesure d'audience affiche un état lisible plutôt qu'une erreur : des statistiques sont une information, jamais une dépendance de l'édition d'une page.",
  },
  {
    question: "Ce site de démonstration est-il à garder ?",
    answer:
      "Non, il est fait pour être supprimé. Ces pages existent pour montrer comment les morceaux se branchent — un agent qui reprend le template les remplace par les vôtres.",
  },
]
---

<section class="border-b border-rule">
  <div class="mx-auto max-w-3xl px-6 py-20 sm:py-24">
    <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Questions</h2>

    <div class="mt-12 divide-y divide-rule border-y border-rule">
      {items.map((item) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-left text-base font-medium marker:content-['']">
            {item.question}
            {/* Le marqueur pivote à l'ouverture ; `aria-hidden` parce que
                l'état ouvert/fermé est déjà porté par <details>. */}
            <span
              aria-hidden="true"
              class="mt-1 shrink-0 text-ink-faint transition-transform group-open:rotate-45"
            >
              +
            </span>
          </summary>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-mid">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
