---
export const prerender = false

import { loadPage } from "../lib/loadPage"
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/hero/Hero.astro"
import CTA from "../components/CTA.astro"

const { page } = await loadPage(Astro)
---

<BaseLayout page={page} fallbackTitle="Paiement confirmé">
  <Hero
    variant="centered"
    size="md"
    eyebrow="Paiement"
    headline="Paiement confirmé"
    subheadline="Merci. Votre règlement de l'offre Complet a bien été reçu. Vous allez recevoir les instructions de livraison par e-mail."
  />

  <CTA
    eyebrow="Et maintenant ?"
    title="Besoin d'un coup de main pour démarrer ?"
    content="Écrivez-nous : on vous indique les prochaines étapes, sans jargon."
    primaryText="Nous écrire"
    primaryHref="/contact"
  />
</BaseLayout>
