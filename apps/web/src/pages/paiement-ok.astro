export const prerender = false

import { loadPage } from "../lib/loadPage"
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/hero/Hero.astro"
import CTA from "../components/CTA.astro"

const { page } = await loadPage(Astro)
---

<BaseLayout page={page} fallbackTitle="Paiement confirmé">
  <Hero
    variant="centered"
    size="md"
    eyebrow="Paiement"
    headline="C'est réglé"
    subheadline="Le paiement de l'offre Complet a bien été reçu. Vous pouvez revenir à l'accueil, ou nous écrire si quelque chose manque."
  />
  <CTA
    eyebrow="Et maintenant ?"
    title="Merci."
    content="L'offre Complet est un paiement unique. Aucun abonnement n'a été ouvert."
    primaryText="Retour à l'accueil"
    primaryHref="/"
  />
</BaseLayout>
