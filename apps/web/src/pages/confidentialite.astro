---
// Politique de confidentialité — l'information que le RGPD (articles 13 et
// 14) impose de donner AVANT de collecter quoi que ce soit : quoi, pourquoi,
// sur quelle base, combien de temps, vers qui, et quels droits.
//
// Le tableau des traitements vient de `src/config/legal.ts`. Il décrit ce
// que ce dépôt fait réellement — ce que le visiteur déclenche (contact,
// audience, choix de cookies) ET ce que l'administration stocke sans qu'il
// le voie (comptes, sessions avec leur adresse IP, invitations, auteurs des
// contenus). Un adoptant qui ajoute un traitement ajoute une ligne ; en
// garder une pour faire sérieux serait une déclaration fausse, ce qui est
// exactement ce que le règlement sanctionne — et en OUBLIER une, qui est le
// défaut qu'un audit a relevé ici, l'est tout autant : une donnée stockée
// et non déclarée rend cette page fausse au sens des articles 13 et 30.
//
// Le balisage lui-même vit dans `ConfidentialiteBody.astro` — voir
// `mentions-legales.astro` pour la raison du découpage (rendre le corps
// testable sans simuler Convex).
//
// Sa ligne doit exister dans le dashboard avec le slug `confidentialite`,
// et être publiée — sinon cette route répond 404, délibérément.
export const prerender = false

import { loadPage } from "../lib/loadPage"
import BaseLayout from "../layouts/BaseLayout.astro"
import ConfidentialiteBody from "../components/legal/ConfidentialiteBody.astro"
import { ASTROTAN_TEMPLATE_NOT_YET_CUSTOMIZED, dpo, legalEntity, processings } from "../config/legal"
import { consentConfig } from "../config/consent"

const { page: loadedPage } = await loadPage(Astro)

// Voir `mentions-legales.astro` pour la raison de ce `noindex` forcé : le
// registre des traitements ci-dessous est vrai et reste publié tel quel,
// mais tant que « qui est responsable » n'est pas renseigné, cette page ne
// doit pas être la version que les moteurs de recherche indexent.
const page =
  loadedPage && ASTROTAN_TEMPLATE_NOT_YET_CUSTOMIZED
    ? { ...loadedPage, seo: { ...loadedPage.seo, noindex: true } }
    : loadedPage
---

<BaseLayout page={page} fallbackTitle="Politique de confidentialité">
  <ConfidentialiteBody
    entity={legalEntity}
    dpo={dpo}
    processings={processings}
    unconfigured={ASTROTAN_TEMPLATE_NOT_YET_CUSTOMIZED}
    consentVersion={consentConfig.consentVersion}
  />
</BaseLayout>
