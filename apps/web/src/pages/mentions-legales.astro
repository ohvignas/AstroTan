---
// Mentions légales — obligatoires pour tout site accessible au public en
// France (LCEN, article 6-III). Ce qui doit y figurer est fixé par la loi :
// qui édite, qui dirige la publication, qui héberge, et comment les joindre.
//
// L'identité vient de `src/config/legal.ts`, jamais écrite ici : les mêmes
// valeurs apparaissent sur trois pages, et une adresse changée à deux
// endroits sur trois est le défaut que ce fichier existe pour empêcher.
//
// Sa ligne doit exister dans le dashboard avec le slug `mentions-legales`,
// et être publiée — sinon cette route répond 404, délibérément.
export const prerender = false

import { loadPage } from "../lib/loadPage"
import BaseLayout from "../layouts/BaseLayout.astro"
import { legalEntity, legalHost } from "../config/legal"

const { page } = await loadPage(Astro)
---

<BaseLayout page={page} fallbackTitle="Mentions légales">
  <section class="legal container">
    <h1>Mentions légales</h1>

    <div class="prose">
      <h2>Éditeur du site</h2>
      <p>
        {legalEntity.name}<br />
        {legalEntity.form}<br />
        {legalEntity.address}<br />
        {legalEntity.registration && <>Immatriculation : {legalEntity.registration}<br /></>}
        {legalEntity.vat && <>TVA intracommunautaire : {legalEntity.vat}<br /></>}
        Courriel : <a href={`mailto:${legalEntity.email}`}>{legalEntity.email}</a>
        {legalEntity.phone && <><br />Téléphone : {legalEntity.phone}</>}
      </p>

      <h2>Directeur de la publication</h2>
      <p>{legalEntity.publicationDirector}</p>

      <h2>Hébergement</h2>
      <p>
        {legalHost.name}<br />
        {legalHost.address}<br />
        {legalHost.contact}
      </p>

      <h2>Propriété intellectuelle</h2>
      <p>
        Les textes, images et éléments graphiques de ce site sont protégés.
        Leur reproduction, même partielle, demande un accord écrit — à
        l'exception du code source, publié sous licence libre, dont les
        conditions sont celles de sa licence.
      </p>

      <h2>Données personnelles et cookies</h2>
      <p>
        Ce que ce site collecte, pourquoi, et pendant combien de temps est
        décrit dans la <a href="/confidentialite">politique de confidentialité</a>.
        Les traceurs déposés, et le moyen de revenir sur votre choix, sont
        dans la <a href="/cookies">politique de cookies</a>.
      </p>

      <h2>Signaler un contenu</h2>
      <p>
        Un contenu vous paraît illicite ? Écrivez à{" "}
        <a href={`mailto:${legalEntity.email}`}>{legalEntity.email}</a> en
        indiquant l'adresse exacte de la page. Nous répondons à chaque
        signalement.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding-block: var(--space-3xl);
    max-width: 48rem;
  }

  .legal h1 {
    margin: 0 0 var(--space-lg);
  }
</style>
