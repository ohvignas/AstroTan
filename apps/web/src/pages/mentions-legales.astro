---
// Mentions légales — obligatoires pour tout site accessible au public en
// France (LCEN, article 6-III). Ce qui doit y figurer est fixé par la loi :
// qui édite, qui dirige la publication, qui héberge, et comment les joindre.
//
// L'identité vient de `src/config/legal.ts`, jamais écrite ici : les mêmes
// valeurs apparaissent sur trois pages, et une adresse changée à deux
// endroits sur trois est le défaut que ce fichier existe pour empêcher.
//
// Le balisage lui-même vit dans `MentionsLegalesBody.astro` — cette page ne
// fait que résoudre les données (Convex via `loadPage`, config via
// `legal.ts`) et les lui passer en props. Le découpage n'est pas cosmétique :
// `legal.test.ts` a besoin de rendre le corps de la page SANS simuler
// Convex pour prouver, sur le HTML réellement produit, que l'identité
// d'exemple n'y apparaît jamais tant que le site n'est pas personnalisé.
//
// Sa ligne doit exister dans le dashboard avec le slug `mentions-legales`,
// et être publiée — sinon cette route répond 404, délibérément.
export const prerender = false

import { loadPage } from "../lib/loadPage"
import BaseLayout from "../layouts/BaseLayout.astro"
import MentionsLegalesBody from "../components/legal/MentionsLegalesBody.astro"
import { ASTROTAN_TEMPLATE_NOT_YET_CUSTOMIZED, legalEntity, legalHost } from "../config/legal"

const { page: loadedPage } = await loadPage(Astro)

// Une page réglementaire qui n'a pas encore d'identité à publier n'a rien à
// faire dans un moteur de recherche : la retrouver depuis Google pour lire
// « AstroTan » comme responsable de traitement serait pire que de ne pas la
// trouver du tout. On force `noindex` ici plutôt que d'exiger que chaque
// adoptant y pense dans le dashboard — le réglage qui y est publié reprend
// la main dès que le marqueur repasse à `false`. Voir le raisonnement complet
// dans `src/config/legal.ts`, au-dessus d'`ASTROTAN_TEMPLATE_NOT_YET_CUSTOMIZED`.
const page =
  loadedPage && ASTROTAN_TEMPLATE_NOT_YET_CUSTOMIZED
    ? { ...loadedPage, seo: { ...loadedPage.seo, noindex: true } }
    : loadedPage
---

<BaseLayout page={page} fallbackTitle="Mentions légales">
  <MentionsLegalesBody
    entity={legalEntity}
    host={legalHost}
    unconfigured={ASTROTAN_TEMPLATE_NOT_YET_CUSTOMIZED}
  />
</BaseLayout>
