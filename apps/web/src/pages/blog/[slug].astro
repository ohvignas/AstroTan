---
// Un article. Le design vient de `BlogLayout`, porté du template ; le
// câblage est le nôtre et ne change pas.
//
// Les trois lignes de `loadPost` sont tout le contrat, et ce sont
// l'équivalent pour un article de celles d'`index.astro` : publication,
// aperçu (`?t=…`), 404 et étiquettes de cache.
export const prerender = false

import { api } from "@astrotan/backend/convex/_generated/api"
import type { Id } from "@astrotan/backend/convex/_generated/dataModel"
import { getConvexClient } from "../../lib/convexClient"
import { loadPost, type PostSummary } from "../../lib/loadPost"
import { renderStoredHtml, htmlToPlainText } from "../../lib/markdown"
import { extractHeadings } from "../../lib/toc"
import BaseLayout from "../../layouts/BaseLayout.astro"
import BlogLayout from "../../layouts/BlogLayout.astro"

const { slug } = Astro.params
const { post, preview } = await loadPost(Astro, slug ?? "")

// `post.body` est de l'HTML rédigé dans l'éditeur riche du dashboard. Il est
// tout de même assaini avant d'atteindre un visiteur — la valeur vient d'une
// session authentifiée, jamais d'un visiteur, et elle est assainie quand
// même.
const sanitized = post === null ? "" : renderStoredHtml(post.body)

// Assainir d'abord, poser les ancres ensuite : `sanitize-html` n'autorise pas
// `id`, donc un `id` posé en amont serait retiré. Voir `lib/toc.ts`.
const { headings, html: bodyHtml } = extractHeadings(sanitized)

// La couverture. `getPublishedPost` la résout côté serveur (`withCover`),
// mais `previewPost` renvoie la ligne brute — d'où le repli explicite sur
// `media.publicUrl`, sans lequel un brouillon en aperçu n'aurait pas d'image.
//
// C'est la correction d'un vrai défaut : la page lisait `post.coverUrl`,
// que `PostRecord` ne déclarait pas. La couverture ne s'affichait donc
// jamais — sans erreur, sans avertissement.
let coverUrl: string | null = post?.coverUrl ?? null
if (post !== null && coverUrl === null && post.coverId) {
  coverUrl = await getConvexClient().query(api.media.publicUrl, {
    storageId: post.coverId as Id<"_storage">,
  })
}

// Les articles liés. La même query publique que `/blog` — elle filtre les
// brouillons côté serveur — dont on retire celui qu'on lit.
const related: PostSummary[] =
  post === null
    ? []
    : ((await getConvexClient().query(api.posts.listPublishedPosts, {})) as PostSummary[])

const canonicalUrl =
  post?.seo?.canonicalUrl ?? new URL(Astro.url.pathname, Astro.url.origin).href
---

{post === null ? (
  <BaseLayout page={null} fallbackTitle="Article introuvable">
    <section class="container empty-state">
      <h1>404</h1>
      <p>Cet article n'existe pas.</p>
      <a href="/blog">Retour au blog</a>
    </section>
  </BaseLayout>
) : (
  <BlogLayout
    post={post}
    headings={headings}
    coverUrl={coverUrl}
    coverAlt={post.coverAlt ?? ""}
    canonicalUrl={canonicalUrl}
    relatedPosts={related.map((entry) => ({
      ...entry,
      // Un article sans résumé doit quand même se lire dans une carte.
      excerpt: entry.excerpt || htmlToPlainText(entry.body, 160),
    }))}
    preview={preview}
  >
    <Fragment set:html={bodyHtml} />
  </BlogLayout>
)}

<style>
  .empty-state {
    display: flex;
    min-height: 60svh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
  }

  .empty-state h1 {
    font-size: 2rem;
    margin: 0;
  }

  .empty-state p {
    margin: 0;
    color: var(--muted-foreground);
  }
</style>
