---
// One article. The example this template ships with — plain on purpose.
//
// The three lines below are the whole contract, and they are the article
// equivalent of the ones in `index.astro`. `loadPost` handles publication,
// preview (`?t=…`), the 404, and the cache tags; nothing else to wire up.
export const prerender = false

import { Image } from "astro:assets"
import { loadPost } from "../../lib/loadPost"
import { renderStoredHtml } from "../../lib/markdown"
import SiteHeader from "../../components/SiteHeader.astro"
import SiteFooter from "../../components/SiteFooter.astro"
import "../../styles/global.css"

const { slug } = Astro.params
const { post, preview } = await loadPost(Astro, slug ?? "")

// `post.body` is HTML authored in the dashboard's rich editor. It is still
// sanitised before reaching a visitor — the value comes from an
// authenticated session, never from a visitor, and is sanitised anyway.
const bodyHtml = post === null ? "" : renderStoredHtml(post.body)

const canonicalUrl =
  post?.seo?.canonicalUrl ?? new URL(Astro.url.pathname, Astro.url.origin).href
const dateFormat = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" })
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{post?.seo?.title || post?.title || "Article introuvable"}</title>
    {post?.seo?.description && (
      <meta name="description" content={post.seo.description} />
    )}
    <link rel="canonical" href={canonicalUrl} />
    <meta
      name="robots"
      content={post?.seo?.noindex ? "noindex, nofollow" : "index, follow"}
    />
  </head>
  <body class="bg-white text-ink antialiased">
    <SiteHeader />
    {preview && (
      <p class="bg-amber-100 px-6 py-2 text-center text-sm text-amber-900">
        Aperçu — cet article n'est pas publié. Le lien expire au bout de 15
        minutes.
      </p>
    )}

    {post === null ? (
      <main class="mx-auto flex min-h-svh max-w-2xl flex-col items-center justify-center gap-3 px-6 text-center">
        <h1 class="text-3xl font-bold">404</h1>
        <p class="text-ink-mid">Cet article n'existe pas.</p>
        <a href="/blog" class="underline">Retour au blog</a>
      </main>
    ) : (
      <main class="mx-auto max-w-3xl px-6 py-16">
        <a href="/blog" class="text-sm text-ink-mid underline">← Blog</a>
        <h1 class="mt-6 text-4xl font-bold">{post.title}</h1>
        {post.publishedAt && (
          <p class="mt-2 text-sm text-ink-mid">
            <time datetime={new Date(post.publishedAt).toISOString()}>
              {dateFormat.format(post.publishedAt)}
            </time>
          </p>
        )}
        {post.coverUrl && (
          /* `<Image>` sur une URL *distante* : Astro ne l'optimise que
             parce que le domaine de Convex storage est autorisé dans
             `astro.config.ts` (`image.remotePatterns`). Sans cette
             autorisation, l'image traverserait le pipeline sans être
             touchée — pas de `srcset`, pas d'AVIF/WebP — et rien ne le
             signalerait. `inferSize` lit les dimensions réelles du fichier
             distant, ce qui évite le décalage de mise en page.

             `loading="eager"` et `fetchpriority="high"` : sur un article,
             la couverture est l'élément LCP. */
          <Image
            src={post.coverUrl}
            alt={post.coverAlt}
            inferSize
            loading="eager"
            fetchpriority="high"
            class="mt-8 w-full rounded-lg"
          />
        )}
        <article
          class="mt-10 leading-relaxed [&_a]:underline [&_blockquote]:border-l-2 [&_blockquote]:pl-4 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_img]:rounded-lg [&_li]:ml-5 [&_ol]:mt-4 [&_ol]:list-decimal [&_p]:mt-4 [&_pre]:mt-4 [&_pre]:overflow-x-auto [&_pre]:rounded-lg [&_pre]:bg-ink [&_pre]:p-4 [&_pre]:text-sm [&_ul]:mt-4 [&_ul]:list-disc"
          set:html={bodyHtml}
        />
      </main>
    )}
    <SiteFooter />
  </body>
</html>
