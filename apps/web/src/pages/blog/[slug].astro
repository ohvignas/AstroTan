---
// Un article. L'habillage vient du template ; `loadPost` et le rendu du
// corps ne changent pas.
//
// Les trois lignes ci-dessous sont tout le contrat, et ce sont l'équivalent
// pour un article de celles d'`index.astro`. `loadPost` gère la
// publication, l'aperçu (`?t=…`), le 404 et les étiquettes de cache ; il n'y
// a rien d'autre à brancher.
export const prerender = false

import { Image } from "astro:assets"
import { loadPost } from "../../lib/loadPost"
import { renderStoredHtml } from "../../lib/markdown"
import BaseLayout from "../../layouts/BaseLayout.astro"

const { slug } = Astro.params
const { post, preview } = await loadPost(Astro, slug ?? "")

// `post.body` est du HTML rédigé dans l'éditeur riche du dashboard. Il est
// tout de même assaini avant d'atteindre un visiteur — la valeur vient
// d'une session authentifiée, jamais d'un visiteur, et elle est assainie
// quand même.
const bodyHtml = post === null ? "" : renderStoredHtml(post.body)

const dateFormat = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" })
---

<BaseLayout
  page={post}
  fallbackTitle="Article introuvable"
  article={post
    ? {
        title: post.title,
        excerpt: post.excerpt,
        publishedAt: post.publishedAt,
        coverUrl: post.coverUrl,
      }
    : undefined}
>
  {preview && (
    <p class="preview-banner">
      Aperçu — cet article n'est pas publié. Le lien expire au bout de 15
      minutes.
    </p>
  )}

  {post === null ? (
    <section class="container empty-state">
      <h1>404</h1>
      <p>Cet article n'existe pas.</p>
      <a href="/blog">Retour au blog</a>
    </section>
  ) : (
    <article class="container post">
      <a class="post__back" href="/blog">← Blog</a>
      <h1 class="post__title">{post.title}</h1>
      {post.publishedAt && (
        <p class="post__date">
          <time datetime={new Date(post.publishedAt).toISOString()}>
            {dateFormat.format(post.publishedAt)}
          </time>
        </p>
      )}
      {post.coverUrl && (
        /* `<Image>` sur une URL *distante* : Astro ne l'optimise que parce
           que le domaine du stockage Convex est autorisé dans
           `astro.config.ts` (`image.remotePatterns`). Sans cette
           autorisation, l'image traverserait le pipeline sans être touchée
           — pas de `srcset`, pas d'AVIF/WebP — et rien ne le signalerait.
           `inferSize` lit les dimensions réelles du fichier distant, ce qui
           évite le décalage de mise en page.

           `loading="eager"` et `fetchpriority="high"` : sur un article, la
           couverture est l'élément LCP. */
        <Image
          src={post.coverUrl}
          alt={post.coverAlt}
          inferSize
          loading="eager"
          fetchpriority="high"
          class="post__cover"
        />
      )}
      <div class="prose post__body" set:html={bodyHtml} />
    </article>
  )}
</BaseLayout>

<style>
  .preview-banner {
    margin: 0;
    padding: 0.6rem 1rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--warning-foreground, var(--foreground));
    background: color-mix(in srgb, var(--warning) 25%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--warning) 45%, transparent);
  }

  .post {
    max-width: 46rem;
    padding-block: var(--space-3xl);
  }

  .post__back {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .post__title {
    margin: var(--space-lg) 0 0;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .post__date {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--faint-foreground);
  }

  .post__cover {
    margin-top: var(--space-xl);
    width: 100%;
    height: auto;
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-border);
  }

  /* `.prose` vit dans `styles/global.css` : le corps d'un article est du
     HTML injecté, donc hors de portée d'un style scopé. */
  .post__body {
    margin-top: var(--space-2xl);
    max-width: none;
  }

  .empty-state {
    display: flex;
    min-height: 60svh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
  }

  .empty-state h1 {
    font-size: 2rem;
    margin: 0;
  }

  .empty-state p {
    margin: 0;
    color: var(--muted-foreground);
  }
</style>
