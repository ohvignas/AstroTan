---
// La page de contact. Sa ligne doit exister dans le dashboard avec le slug
// `contact`, et être publiée — sinon cette route répond 404, délibérément.
//
// Le formulaire poste vers `/api/contact`, qui valide le corps, limite
// le débit, et écrit un lead. Pas de JavaScript : un envoi HTTP natif
// suffit.
export const prerender = false

import { loadPage } from "../lib/loadPage"
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/hero/Hero.astro"
import {
  MAX_LEAD_BODY_LENGTH,
  MAX_LEAD_EMAIL_LENGTH,
  MAX_LEAD_NAME_LENGTH,
  MAX_LEAD_SUBJECT_LENGTH,
} from "@astrotan/backend/convex/content"

const { page } = await loadPage(Astro)

// L'issue de l'envoi précédent, transmise par la redirection de
// `/api/contact`. Passer par l'URL plutôt que par une session garde la page
// sans état : rafraîchir n'affiche pas deux fois le même message, et rien
// n'est stocké côté serveur pour un simple accusé de réception.
const envoye = Astro.url.searchParams.get("envoye") === "1"
const erreur = Astro.url.searchParams.get("erreur")

// Les bornes sont les MÊMES que celles que la mutation applique : le
// `maxlength` du navigateur est un confort, la vérification qui compte est
// côté serveur. Les importer plutôt que les recopier évite qu'ils divergent.
const MESSAGES_ERREUR: Record<string, string> = {
  invalid_email: "Cette adresse email ne semble pas valide. Vérifiez-la et renvoyez.",
  empty: "Le nom et le message ne peuvent pas être vides.",
  too_long: `Le message dépasse ${MAX_LEAD_BODY_LENGTH} caractères. Raccourcissez-le, ou écrivez-nous directement par email.`,
  illisible: "Le formulaire n'a pas pu être lu. Réessayez.",
  // Une panne de notre côté. Le dire franchement, et donner l'autre chemin :
  // quelqu'un qui a une question n'a pas à attendre que nous soyons réparés.
  // Un motif distinct de « indisponible » : ici le service marche, c'est le
  // rythme qui est refusé, et la personne n'a rien d'autre à faire
  // qu'attendre. Lui proposer l'email serait l'envoyer contourner une
  // limite qui existe pour une raison.
  trop_d_envois:
    "Vous avez envoyé plusieurs messages coup sur coup. Patientez un moment avant de réessayer — les précédents nous sont bien parvenus.",
  indisponible:
    "L'envoi est momentanément indisponible. Écrivez-nous par email, votre message arrivera au même endroit.",
}

---

<BaseLayout page={page} fallbackTitle="Page introuvable">
  {page === null ? (
    <section class="container empty-state">
      <h1>404</h1>
      <p>Cette page n'existe pas.</p>
    </section>
  ) : (
    <>
      <Hero
        variant="centered"
        size="md"
        eyebrow="Contact"
        headline="Écrivez-nous"
        subheadline="Une question sur le template, une reprise à faire, un doute sur une décision d'architecture : écrivez-nous ci-dessous, on répond sous un jour ouvré."
      />

      <section class="container contact">
        {/* Le formulaire poste vers `/api/contact` en HTTP natif. Pas de
            JavaScript : il fonctionne script bloqué, script en échec, ou
            avant que quoi que ce soit ait chargé — et sur un formulaire de
            contact, un message perdu ne se voit jamais. */}
        <form class="contact__form" method="post" action="/api/contact">
          <h2 class="contact__form-title">Écrivez-nous</h2>

          {envoye && (
            <p class="contact__flash contact__flash--ok" role="status">
              Message reçu. Nous répondons sous un jour ouvré.
            </p>
          )}
          {erreur && (
            <p class="contact__flash contact__flash--ko" role="alert">
              {MESSAGES_ERREUR[erreur] ??
                "Le message n'a pas pu être envoyé. Réessayez, ou écrivez-nous par email."}
            </p>
          )}

          <div class="contact__row">
            <label class="contact__field">
              <span>Votre nom</span>
              <input type="text" name="name" required maxlength={MAX_LEAD_NAME_LENGTH} autocomplete="name" />
            </label>
            <label class="contact__field">
              <span>Votre adresse email</span>
              <input type="email" name="email" required maxlength={MAX_LEAD_EMAIL_LENGTH} autocomplete="email" />
            </label>
          </div>

          <label class="contact__field">
            <span>Sujet <em>(facultatif)</em></span>
            <input type="text" name="subject" maxlength={MAX_LEAD_SUBJECT_LENGTH} />
          </label>

          <label class="contact__field">
            <span>Votre message</span>
            <textarea name="message" rows="6" required maxlength={MAX_LEAD_BODY_LENGTH}></textarea>
          </label>

          {/* Le pot de miel : caché à l'œil, pas au robot. `aria-hidden` et
              `tabindex="-1"` le retirent aussi du parcours clavier et des
              lecteurs d'écran, sinon c'est un piège pour les humains qui
              n'utilisent pas la souris. Rempli, le serveur répond comme à
              un succès — dire « raté » à un robot, c'est lui apprendre à
              réussir. */}
          <div class="contact__honeypot" aria-hidden="true">
            <label>
              Site web
              <input type="text" name="site_web" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <button type="submit" class="contact__submit">Contacter maintenant</button>

          {/* L'information due AU MOMENT de la collecte (RGPD, article 13),
              pas seulement sur une page qu'il faudrait aller chercher. Deux
              phrases : à quoi ça sert, combien de temps ça reste, et où lire
              le reste. Plus long, personne ne le lit ; absent, c'est le
              manquement le plus souvent relevé sur un formulaire public. */}
          <p class="contact__legal">
            Votre nom, votre adresse email et votre message ne servent qu'à
            vous répondre : ni prospection, ni revente. Ils restent dans notre
            base jusqu'à ce que nous les supprimions — ce qui est conservé, et
            comment nous demander de l'effacer, sont dans la{" "}
            <a href="/confidentialite">politique de confidentialité</a>.
          </p>
        </form>




      </section>
    </>
  )}
</BaseLayout>

<style>
  .contact {
    padding-block: var(--space-3xl);
  }







  .contact__note {
    max-width: 44rem;
    margin: var(--space-2xl) auto 0;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .empty-state {
    display: flex;
    min-height: 60svh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
  }

  .empty-state h1 {
    font-size: 2rem;
    margin: 0;
  }

  .empty-state p {
    margin: 0;
    color: var(--muted-foreground);
  }

  .contact__form {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--color-bg-secondary);
  }

  .contact__form-title {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    letter-spacing: -0.01em;
  }

  /* Deux colonnes sur large, une seule dès qu'on manque de place — un champ
     de saisie à moitié large est plus pénible qu'un champ empilé. */
  .contact__row {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .contact__field {
    display: grid;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .contact__field em {
    font-style: normal;
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .contact__field input,
  .contact__field textarea {
    width: 100%;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-primary);
    color: var(--color-text-primary);
    font: inherit;
    font-weight: 400;
  }

  .contact__field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .contact__field input:focus-visible,
  .contact__field textarea:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  /* Hors écran, pas `display: none` : un champ masqué ainsi est ignoré par
     une partie des robots, ce qui viderait le piège de son intérêt. */
  .contact__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .contact__submit {
    justify-self: start;
    padding: 0.75rem 1.5rem;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--color-text-primary);
    color: var(--color-bg-primary);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .contact__submit:hover {
    opacity: 0.9;
  }

  /* Sous le bouton, dans le même cadre que les champs : l'information n'a
     de valeur que là où la saisie se fait. Discrète, jamais masquée — une
     mention qu'on rend illisible ne vaut pas mieux que pas de mention. */
  .contact__legal {
    margin: 0;
    max-width: 44rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .contact__legal a {
    color: inherit;
    text-decoration: underline;
  }

  .contact__flash {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-lg);
    font-size: 0.875rem;
    border: 1px solid var(--color-border);
  }

  .contact__flash--ok {
    border-color: color-mix(in srgb, var(--brand) 40%, transparent);
    background: color-mix(in srgb, var(--brand) 8%, transparent);
  }

  .contact__flash--ko {
    border-color: color-mix(in srgb, red 35%, var(--color-border));
  }
</style>
