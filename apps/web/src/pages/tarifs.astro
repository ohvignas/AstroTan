---
// Portée de `src/pages/pricing.astro` d'`astro-emdash`, avec SES trois
// paliers de démonstration — en anglais, tel quel. Inventer des tarifs pour
// AstroTan aurait été écrire du faux ; cette page montre la mise en page,
// pas une offre. Elle est faite pour être supprimée ou réécrite.
//
// Le fichier s'appelle `tarifs.astro` et non `pricing.astro` : le site est en
// français, et le chemin servi fait partie de ce qu'un visiteur lit.
//
// Sa ligne doit exister dans le dashboard avec le slug `tarifs`, et être
// publiée — sinon cette route répond 404, délibérément.
export const prerender = false

import { loadPage } from "../lib/loadPage"
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/hero/Hero.astro"
import Pricing from "../components/sections/Pricing.astro"
import CTA from "../components/CTA.astro"
import { formatCompletPriceFr } from "@astrotan/backend/convex/lib/stripeOffer"

const { page } = await loadPage(Astro)

const plans = [
  {
    name: "Gratuit",
    price: "0 €",
    description:
      "Le site vitrine, complet. Vous le clonez, vous l'hébergez, il est à vous.",
    features: [
      "Le site public et toutes ses pages",
      "Référencement : sitemap, llms.txt, données structurées",
      "Déploiement Docker sur votre propre serveur",
      "Le code source, sous licence libre",
    ],
    cta: { label: "Cloner le dépôt", href: "https://github.com/OhVignas/AstroTan" },
  },
  {
    name: "Complet",
    price: formatCompletPriceFr(),
    // Paiement unique, pas un abonnement. Le composant affiche `period`
    // juste après le prix : y écrire « une fois » évite la lecture par
    // défaut, qui est mensuelle dès qu'un tarif est affiché à côté d'une
    // offre gratuite.
    period: "une fois",
    description:
      "Le site, plus l'administration qui va avec — et de quoi savoir ce qu'elle produit.",
    features: [
      "Tout ce que comprend l'offre gratuite",
      "Payé une fois, pas d'abonnement",
      "Le tableau de bord : pages, articles, médias, redirections",
      "Les statistiques d'audience, par page",
      "Le suivi des messages reçus",
      "L'agent IA — un assistant sur votre site (à venir)",
    ],
    cta: { label: "Payer", href: "/api/checkout", method: "post" },
    // Mise en avant : c'est l'offre qui répond à la question que se pose
    // quelqu'un qui compare, et la laisser au milieu sans marque obligerait
    // à lire les trois colonnes pour s'en apercevoir.
    featured: true,
  },
  {
    name: "Sur mesure",
    price: "Sur devis",
    description:
      "Votre site construit avec vous, avec les fonctionnalités dont vous avez besoin.",
    features: [
      "Tout ce que comprend l'offre complète",
      "Conception et intégration de vos pages",
      "Les fonctionnalités propres à votre métier",
      "Reprise de l'existant et mise en ligne",
    ],
    cta: { label: "En parler", href: "/contact" },
  },
]
---

<BaseLayout page={page} fallbackTitle="Page introuvable">
  {page === null ? (
    <section class="container empty-state">
      <h1>404</h1>
      <p>Cette page n'existe pas.</p>
    </section>
  ) : (
    <>
      <Hero
        variant="centered"
        size="md"
        eyebrow="Tarifs"
        headline="Le site est gratuit. Le reste est à 9,99 €, une fois"
        subheadline="Trois offres, aucune ligne cachée, aucun abonnement. Le site vitrine ne coûte rien et n'expire pas ; l'administration qui va avec se paie une seule fois."
      />

      <div data-animate>
        <Pricing plans={plans} />
      </div>

      <CTA
        eyebrow="Une question ?"
        title="Pas sûr de l'offre qu'il vous faut ?"
        content="Écrivez-nous, on vous répond avec ce qui correspond à votre cas — et on vous dira si l'offre gratuite suffit."
        primaryText="Nous écrire"
        primaryHref="/contact"
      />
    </>
  )}
</BaseLayout>

<style>
  .empty-state {
    display: flex;
    min-height: 60svh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
  }

  .empty-state h1 {
    font-size: 2rem;
    margin: 0;
  }

  .empty-state p {
    margin: 0;
    color: var(--muted-foreground);
  }
</style>
