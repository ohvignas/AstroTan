---
export const prerender = false

import { api } from "@astrotan/backend/convex/_generated/api"
import { loadPage } from "../lib/loadPage"
import { getConvexClient } from "../lib/convexClient"
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/hero/Hero.astro"
import Pricing from "../components/sections/Pricing.astro"
import CTA from "../components/CTA.astro"

const { page } = await loadPage(Astro)
const erreur = Astro.url.searchParams.get("erreur")
let paiement = { ready: false, livemode: false }
try {
  paiement = await getConvexClient().query(api.payments.publicStatus, {})
} catch {
  paiement = { ready: false, livemode: false }
}

const plans = [
  {
    name: "Gratuit",
    price: "0 €",
    description:
      "Le site vitrine, complet. Vous le clonez, vous l'hébergez, il est à vous.",
    features: [
      "Le site public et toutes ses pages",
      "Référencement : sitemap, llms.txt, données structurées",
      "Déploiement Docker sur votre propre serveur",
      "Le code source, sous licence libre",
    ],
    cta: { label: "Cloner le dépôt", href: "https://github.com/OhVignas/AstroTan" },
  },
  {
    name: "Complet",
    price: "29,99 €",
    period: "une fois",
    description:
      "Le site, plus l'administration qui va avec — et de quoi savoir ce qu'elle produit.",
    features: [
      "Tout ce que comprend l'offre gratuite",
      "Payé une fois, pas d'abonnement",
      "Le tableau de bord : pages, articles, médias, redirections",
      "Les statistiques d'audience, par page",
      "Le suivi des messages reçus",
      "L'agent IA — un assistant sur votre site",
    ],
    cta: { label: "Payer 29,99 €", action: "/acheter", method: "GET" },
    featured: true,
  },
  {
    name: "Sur mesure",
    price: "Sur devis",
    description:
      "Votre site construit avec vous, avec les fonctionnalités dont vous avez besoin.",
    features: [
      "Tout ce que comprend l'offre complète",
      "Conception et intégration de vos pages",
      "Les fonctionnalités propres à votre métier",
      "Reprise de l'existant et mise en ligne",
    ],
    cta: { label: "En parler", href: "/contact" },
  },
]
---

<BaseLayout page={page} fallbackTitle="Tarifs">
  <Hero
    variant="centered"
    size="md"
    eyebrow="Tarifs"
    headline="Le site est gratuit. Le reste est à 29,99 €, une fois"
    subheadline="Trois offres, aucune ligne cachée, aucun abonnement. Le site vitrine ne coûte rien et n'expire pas ; l'administration qui va avec se paie une seule fois."
  />

  {erreur === "indisponible" && (
    <p class="tarifs-erreur" role="alert">
      Le paiement est momentanément indisponible. Réessayez, ou écrivez-nous.
    </p>
  )}

  {paiement.ready && !paiement.livemode && (
    <p class="tarifs-test" role="status">
      Paiement en mode test — aucune carte réelle ne sera débitée.
    </p>
  )}

  <div data-animate>
    <Pricing plans={plans} />
  </div>

  <CTA
    eyebrow="Une question ?"
    title="Pas sûr de l'offre qu'il vous faut ?"
    content="Écrivez-nous, on vous répond avec ce qui correspond à votre cas — et on vous dira si l'offre gratuite suffit."
    primaryText="Nous écrire"
    primaryHref="/contact"
  />
</BaseLayout>

<style>
  .tarifs-erreur {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    text-align: center;
    color: var(--destructive);
    background: color-mix(in oklab, var(--destructive) 8%, transparent);
    border-radius: var(--radius-lg);
  }

  .tarifs-test {
    max-width: 40rem;
    margin: 0 auto 1rem;
    padding: 0.75rem 1rem;
    text-align: center;
    color: var(--muted-foreground);
    background: color-mix(in oklab, var(--muted) 60%, transparent);
    border-radius: var(--radius-lg);
  }
</style>
