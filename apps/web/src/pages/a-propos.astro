---
// Une page ordinaire, et tout l'intérêt est qu'il n'y a rien à voir :
// ajouter une page à ce site, c'est créer un fichier et recopier les quatre
// lignes ci-dessous. Aucun registre à mettre à jour, aucune configuration à
// toucher.
//
// Elle existe aussi pour rendre une règle visible : une page est en ligne
// quand ses DEUX moitiés existent — ce fichier, et une ligne publiée portant
// le même slug. Créer la ligne seule donne une page qui répond 404, ce qui
// est exactement ce qui est arrivé en écrivant ceci.
//
// Sa ligne doit exister dans le dashboard avec le slug `a-propos`, et être
// publiée — sinon cette route répond 404, délibérément.
export const prerender = false

import { loadPage } from "../lib/loadPage"
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/hero/Hero.astro"
import FeatureGrid from "../components/FeatureGrid.astro"
import CTA from "../components/CTA.astro"

const { page } = await loadPage(Astro)

const values = [
  {
    icon: "code",
    title: "Le code est la maquette",
    description:
      "Le balisage, la mise en page et les mots s'écrivent en code, depuis une maquette. L'administration décide qui doit trouver la page, jamais ce qu'elle contient.",
  },
  {
    icon: "speed",
    title: "Ce qui est affirmé est mesuré",
    description:
      "Zéro octet de JavaScript sur les pages publiques, 12,8 ko à la première visite, 778 tests automatisés. Chaque chiffre de ce site a été relevé sur ce dépôt.",
  },
  {
    icon: "shield",
    title: "Les refus comptent autant",
    description:
      "Pas de constructeur de menu, pas de modèle de contenu éditable, pas de second cache devant Convex. Trois choses essayées puis retirées, et la raison écrite à côté.",
  },
]
---

<BaseLayout page={page} fallbackTitle="Page introuvable">
  {page === null ? (
    <section class="container empty-state">
      <h1>404</h1>
      <p>Cette page n'existe pas.</p>
    </section>
  ) : (
    <>
      <Hero
        variant="centered"
        size="md"
        eyebrow="À propos"
        headline="Un socle pensé pour les sites vitrines modernes"
        subheadline="AstroTan est un template : un site public Astro, un dashboard TanStack Start, un backend Convex partagé par les deux, et une pile Docker qu'on sait annuler. Ce que vous lisez ici est la démonstration, faite pour être supprimée."
      />

      <div data-animate>
        <FeatureGrid title="Ce à quoi on tient" features={values} columns={3} />
      </div>

      <CTA
        eyebrow="La suite"
        title="Prêt à écrire la vôtre ?"
        content="Le dépôt contient les tests qui tiennent ces promesses et la documentation qui explique pourquoi chaque décision a été prise ainsi."
        primaryText="Nous écrire"
        primaryHref="/contact"
        secondaryText="Lire le blog"
        secondaryHref="/blog"
      />
    </>
  )}
</BaseLayout>

<style>
  .empty-state {
    display: flex;
    min-height: 60svh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
  }

  .empty-state h1 {
    font-size: 2rem;
    margin: 0;
  }

  .empty-state p {
    margin: 0;
    color: var(--muted-foreground);
  }
</style>
