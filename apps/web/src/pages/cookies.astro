---
// Politique de cookies. Ce que la page doit contenir pour être utile plutôt
// que décorative : la liste NOMMÉE des traceurs réellement déposés, leur
// durée, leur destinataire, et un moyen de revenir sur son choix qui marche.
//
// La liste est dérivée de la configuration, jamais recopiée à la main : un
// tableau écrit en dur décrit le site du jour où on l'a écrit, et personne
// ne s'aperçoit qu'il a cessé d'être vrai. Ici, ajouter
// `PUBLIC_META_PIXEL_ID` fait apparaître Meta sur cette page le même jour
// que dans le bandeau.
//
// Le balisage lui-même vit dans `CookiesBody.astro` — voir
// `mentions-legales.astro` pour la raison du découpage (rendre le corps
// testable sans simuler Convex).
//
// Sa ligne doit exister dans le dashboard avec le slug `cookies`, et être
// publiée — sinon cette route répond 404, délibérément.
export const prerender = false

import { loadPage } from "../lib/loadPage"
import BaseLayout from "../layouts/BaseLayout.astro"
import CookiesBody from "../components/legal/CookiesBody.astro"
import { api } from "@astrotan/backend/convex/_generated/api"
import { consentTags, shouldAskConsent } from "../lib/consent"
import { consentConfig } from "../config/consent"
import { ASTROTAN_TEMPLATE_NOT_YET_CUSTOMIZED, legalEntity } from "../config/legal"
import { getConvexClient } from "../lib/convexClient"
import { fusionnerPixels } from "../lib/pixelIds"

const { page: loadedPage } = await loadPage(Astro)

// Voir `mentions-legales.astro` pour la raison de ce `noindex` forcé.
const page =
  loadedPage && ASTROTAN_TEMPLATE_NOT_YET_CUSTOMIZED
    ? { ...loadedPage, seo: { ...loadedPage.seo, noindex: true } }
    : loadedPage

const settings = await getConvexClient().query(api.settings.get, {})
const fused = fusionnerPixels(settings, import.meta.env)
const tags = consentTags(fused, consentConfig.googleConsentMode.enabled)
const ask = shouldAskConsent(fused, consentConfig.googleConsentMode.enabled)
const umami = Boolean(
  import.meta.env.PUBLIC_UMAMI_URL && import.meta.env.PUBLIC_UMAMI_WEBSITE_ID,
)
---

<BaseLayout page={page} fallbackTitle="Politique de cookies">
  <CookiesBody
    entity={legalEntity}
    unconfigured={ASTROTAN_TEMPLATE_NOT_YET_CUSTOMIZED}
    tags={tags}
    ask={ask}
    umami={umami}
    expirationDays={consentConfig.expirationDays}
  />
</BaseLayout>
