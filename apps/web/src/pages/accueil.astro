---
// A page of this site: the markup below is the design, written in code —
// here taken verbatim from the static mockup. Nothing about how it looks
// comes from the database.
//
// The three lines of frontmatter are the whole contract with the
// dashboard. `loadPage` fetches the row that decides whether this page is
// live (and honours `?t=` preview links); `PageHead` renders the SEO and
// GEO fields into the head. Copy these three lines into every new page —
// there is nothing else to wire up.
export const prerender = false

import { loadPage } from "../lib/loadPage"
import PageHead from "../components/PageHead.astro"

const { page } = await loadPage(Astro, "accueil")
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PageHead page={page} />
    <link rel="stylesheet" href="/illith-tokens.css" />
    <style is:global>
      html, body { margin: 0; background: #fff; font-family: 'Poppins', system-ui, sans-serif; color: #1A1A2E; }
      a { color: #E8008A; }
      a:hover { color: #B8006D; }
    </style>
  </head>
  <body>
    {page === null ? (
      <main style="max-width:40rem;margin:0 auto;padding:6rem 1.5rem;text-align:center">
        <h1 style="font-size:2rem;margin:0">404</h1>
        <p style="color:#5A545A">Cette page n'existe pas.</p>
      </main>
    ) : (
<section style="position:relative;overflow:hidden;height:670px;display:grid;grid-template-columns:1.05fr 1fr;gap:32px;padding:80px 48px 52px;align-items:center;background:#FFFFFF;box-sizing:border-box"><style>
        @keyframes ill-fadeup { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
        @keyframes ill-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
        @keyframes ill-pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(232,0,138,.35); } 50% { box-shadow: 0 0 0 6px rgba(232,0,138,0); } }
        .ill-hero-fade1 { animation: ill-fadeup .7s cubic-bezier(.2,.7,.3,1) both; }
        .ill-hero-fade2 { animation: ill-fadeup .7s .12s cubic-bezier(.2,.7,.3,1) both; }
        .ill-hero-fade3 { animation: ill-fadeup .7s .24s cubic-bezier(.2,.7,.3,1) both; }
        .ill-hero-fade4 { animation: ill-fadeup .7s .36s cubic-bezier(.2,.7,.3,1) both; }
        .ill-hero-card { animation: ill-fadeup .7s .5s cubic-bezier(.2,.7,.3,1) both, ill-float 5s 1.4s ease-in-out infinite; }
        .ill-hero-card2 { animation: ill-fadeup .7s .65s cubic-bezier(.2,.7,.3,1) both, ill-float 6s 1.8s ease-in-out infinite; }
        .ill-hero-btn { transition: transform .18s ease, box-shadow .18s ease, background .18s ease; }
        .ill-hero-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(232,0,138,.28); background: #B8006D !important; }
        .ill-hero-ghost { transition: transform .18s ease, background .18s ease; }
        .ill-hero-ghost:hover { transform: translateY(-2px); background: #1A1A2E !important; color: #fff !important; }
      </style><div style="position:absolute;inset:0;background-image:radial-gradient(rgba(26,26,46,.055) 1px, transparent 1px);background-size:26px 26px;mask-image:radial-gradient(ellipse 90% 80% at 30% 20%, black, transparent 70%);-webkit-mask-image:radial-gradient(ellipse 90% 80% at 30% 20%, black, transparent 70%)"></div><div style="position:absolute;right:-12%;top:-25%;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle, rgba(232,0,138,.10), transparent 65%);pointer-events:none"></div><div style="display:flex;flex-direction:column;gap:24px;position:relative"><span class="ill-hero-fade1" style="display:inline-flex;align-items:center;gap:9px;align-self:flex-start;font-size:13px;font-weight:500;color:#1A1A2E;background:#FFFFFF;border:1px solid #E6E1E1;border-radius:999px;padding:8px 15px;box-shadow:0 1px 2px rgba(26,26,46,.05)"><span style="width:7px;height:7px;border-radius:999px;background:#E8008A;animation:ill-pulse 2.4s infinite"></span>École No-Code &amp; IA · 100% à distance</span><h1 class="ill-hero-fade2" style="font-family:var(--font-sans, 'Poppins', sans-serif);font-size:clamp(36px, 4vw, 54px);font-weight:800;line-height:1.18;letter-spacing:-0.03em;margin:0;color:#1A1A2E"><span style="white-space:nowrap">Apprenez à créer avec</span><br><span style="color:#E8008A;position:relative;display:inline-block;white-space:nowrap">le No-Code &amp; l'IA</span></h1><p class="ill-hero-fade3" style="font-size:19px;line-height:1.55;color:#5A545A;max-width:500px;margin:0;text-wrap:pretty">Formez-vous aux métiers de la tech avec des parcours certifiants, intensifs et adaptés à vos objectifs, accompagnés par des experts du secteur.</p><div class="ill-hero-fade4" style="display:flex;gap:14px;margin-top:8px;flex-wrap:wrap"><a href="#formations" class="ill-hero-btn" style="display:inline-block;background:#E8008A;color:#fff;padding:16px 28px;border-radius:10px;text-decoration:none;font-weight:600;font-size:15px;box-shadow:0 6px 16px rgba(232,0,138,.22)">Découvrir nos parcours →</a><a href="#" class="ill-hero-ghost" style="display:inline-block;background:transparent;color:#1A1A2E;padding:16px 28px;border-radius:10px;text-decoration:none;font-weight:600;font-size:15px;border:1.5px solid #1A1A2E">Me faire accompagner</a></div><div class="ill-hero-fade4" style="display:flex;gap:14px;align-items:center;margin-top:10px"><span style="display:flex;align-items:center"><img src="/assets/avatar-claire.jpg" alt="" style="width:38px;height:38px;border-radius:50%;object-fit:cover;border:2.5px solid #FFFFFF;box-shadow:0 1px 3px rgba(26,26,46,.15);margin-left:0"><img src="/assets/avatar-mehdi.jpg" alt="" style="width:38px;height:38px;border-radius:50%;object-fit:cover;border:2.5px solid #FFFFFF;box-shadow:0 1px 3px rgba(26,26,46,.15);margin-left:-10px"><img src="/assets/avatar-sophie.jpg" alt="" style="width:38px;height:38px;border-radius:50%;object-fit:cover;border:2.5px solid #FFFFFF;box-shadow:0 1px 3px rgba(26,26,46,.15);margin-left:-10px"></span><span style="display:flex;flex-direction:column;gap:2px"><span style="display:flex;gap:2px;align-items:center"><svg viewBox="0 0 48 48" width="15" height="15" aria-hidden="true" style="margin-right:4px"><path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11.8c-.5 2.7-2 5-4.4 6.6v5.5h7.1c4.1-3.8 6.6-9.4 6.6-16.1z"></path><path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.4l-7.1-5.5c-2 1.3-4.5 2.1-7.4 2.1-5.7 0-10.5-3.8-12.2-9H4.5v5.7C8.1 41.1 15.4 46 24 46z"></path><path fill="#FBBC05" d="M11.8 28.2c-.4-1.3-.7-2.7-.7-4.2s.2-2.9.7-4.2v-5.7H4.5C3 17.1 2.1 20.4 2.1 24s.9 6.9 2.4 9.9l7.3-5.7z"></path><path fill="#EA4335" d="M24 10.8c3.2 0 6.1 1.1 8.4 3.3l6.3-6.3C34.9 4.1 29.9 2 24 2 15.4 2 8.1 6.9 4.5 14.1l7.3 5.7c1.7-5.2 6.5-9 12.2-9z"></path></svg><svg viewBox="0 0 24 24" width="13" height="13" fill="#FFC037"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"></path></svg><svg viewBox="0 0 24 24" width="13" height="13" fill="#FFC037"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"></path></svg><svg viewBox="0 0 24 24" width="13" height="13" fill="#FFC037"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"></path></svg><svg viewBox="0 0 24 24" width="13" height="13" fill="#FFC037"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"></path></svg><svg viewBox="0 0 24 24" width="13" height="13" fill="#FFC037"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"></path></svg></span><span style="font-size:13.5px;color:#5A545A"><b style="color:#1A1A2E">4,8/5</b> sur les avis Google · éligible <b style="color:#1A1A2E">CPF</b></span></span></div></div><div style="position:relative;height:100%;min-height:0"><div style="width:100%;height:100%;overflow:hidden;border-radius:24px;box-shadow:0 24px 60px rgba(26,26,46,.14)"><img src="/assets/brand-homepage-hero.jpg" alt="" style="width:100%;height:100%;object-fit:cover"></div></div></section>
    )}
  </body>
</html>
