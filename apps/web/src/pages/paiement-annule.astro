export const prerender = false

import { loadPage } from "../lib/loadPage"
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/hero/Hero.astro"
import CTA from "../components/CTA.astro"

const { page } = await loadPage(Astro)
---

<BaseLayout page={page} fallbackTitle="Paiement annulé">
  <Hero
    variant="centered"
    size="md"
    eyebrow="Paiement"
    headline="Rien n'a été débité"
    subheadline="Vous avez quitté Stripe avant la confirmation. L'offre Complet reste disponible sur la page Tarifs."
  />
  <CTA
    eyebrow="Reprendre"
    title="Revenir aux tarifs"
    content="Le paiement unique de 9,99 € n'a pas été engagé."
    primaryText="Voir les tarifs"
    primaryHref="/tarifs"
  />
</BaseLayout>
