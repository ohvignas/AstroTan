# Public Convex deployment URL. Read by `src/lib/convexClient.ts` to build
# the `ConvexHttpClient` this app uses for every Convex call — no session,
# no admin key (CLAUDE.md invariant #1). `PUBLIC_` is Astro/Vite's convention
# for env vars shipped to the browser bundle; safe here since this value
# carries no secret.
#
# Same value as `packages/backend/.env.local`'s `CONVEX_URL` and
# `apps/admin`'s `VITE_CONVEX_URL` in local development (or the deployment's
# real *.convex.cloud URL in production). In production this is also passed
# as a Docker build-arg (spec §7): prerendered pages read Convex at build
# time, not at request time.
PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# HMAC key `src/lib/previewToken.ts` uses to verify preview-page tokens
# before this app makes any network call (design spec §6.3, barrier 1 of
# two). No `PUBLIC_` prefix — deliberately the opposite of the var above:
# this one must never reach a browser bundle, so it is read via
# `process.env`, not `import.meta.env`. Must be the *exact same* value as
# the Convex deployment's own `PREVIEW_SECRET`
# (`packages/backend/.env.example`, `packages/backend/convex/lib/previewToken.ts`)
# — barrier 2, Convex's independent re-verification inside `previewPage`,
# only agrees with barrier 1 if both sides were signed/checked with the
# same key. Generate once with `openssl rand -hex 32`, set it here and via
# `npx convex env set` on the Convex deployment, never commit the real
# value. `verifyPreviewToken` throws rather than degrading if it's unset or
# under 32 characters (same guard as the Convex copy).
PREVIEW_SECRET=CHANGE-ME-not-a-real-secret

# HMAC-strength shared secret `src/pages/api/revalidate.ts` compares, in
# constant time, against the `x-revalidate-secret` header on every POST
# from Convex's own `drain` action (design spec §6.2;
# `packages/backend/convex/revalidate.ts`). Must be the *exact same* value
# as that deployment's own `REVALIDATE_SECRET`
# (`packages/backend/.env.example`) — a mismatch here doesn't degrade
# anything gracefully, it makes every publish's invalidation fail closed
# (refused, then retried with backoff by `drain`, then `failed` after 6
# attempts) rather than reach a live page. Generate once with `openssl rand
# -hex 32`, set it here and via `npx convex env set` on the Convex
# deployment, never commit the real value, never send it to a browser.
REVALIDATE_SECRET=CHANGE-ME-not-a-real-secret

# Both `PREVIEW_SECRET` and `REVALIDATE_SECRET` above are read via
# `process.env`, not `import.meta.env`, on purpose: Vite/Astro statically
# inline `import.meta.env.KEY` at build time — even in SSR output, even
# for unprefixed keys — which would freeze whatever value was present at
# `astro build` time into the image forever, exactly wrong for a secret a
# real deployment's container sets and may rotate later. One verified
# local-dev consequence of that choice: `astro dev` does not load this
# file's values into `process.env` the way it loads `PUBLIC_CONVEX_URL`
# into `import.meta.env` above — export both in the shell that starts
# `astro dev` instead (`export PREVIEW_SECRET=... REVALIDATE_SECRET=...`),
# the same way a real deployment's container environment supplies them.
